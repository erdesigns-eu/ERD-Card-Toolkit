# Keep Delphi/Windows working files in the format expected by RAD Studio.
*.pas text eol=crlf whitespace=cr-at-eol
*.dpr text eol=crlf whitespace=cr-at-eol
*.dpk text eol=crlf whitespace=cr-at-eol
*.dfm text eol=crlf whitespace=cr-at-eol
*.dproj text eol=crlf whitespace=cr-at-eol
*.groupproj text eol=crlf whitespace=cr-at-eol
*.cmd text eol=crlf whitespace=cr-at-eol
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf

# Original references must retain their exact bytes and provenance hashes.
reference/legacy/** -text whitespace=cr-at-eol
