<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{D2A63275-0099-522A-AB95-BCD017C05F1A}</ProjectGuid>
    <ProjectVersion>19.0</ProjectVersion>
    <MainSource>MagStripeDemo.dpr</MainSource>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_UnitSearchPath>..\..\..\src\core;..\..\..\src\crypto;..\..\..\src\pcsc;..\..\..\src\eid;..\..\..\src\emv;..\..\..\src\magstripe;..\..\..\src\contactless;..\shared;..\..\..\dist\vcl\$(Platform)\$(Config);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_DcuOutput>..\..\..\dist\vcl\$(Platform)\$(Config)\MagStripeDemo\dcu</DCC_DcuOutput>
    <DCC_ExeOutput>..\..\..\dist\vcl\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_BplOutput>..\..\..\dist\vcl\$(Platform)\$(Config)</DCC_BplOutput>
    <DCC_DcpOutput>..\..\..\dist\vcl\$(Platform)\$(Config)</DCC_DcpOutput>
    <DCC_GenerateDocumentation>true</DCC_GenerateDocumentation>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_OverflowChecking>true</DCC_OverflowChecking>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_DebugInformation>true</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_Optimize>true</DCC_Optimize>
    <DCC_DebugInformation>false</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <DCCReference Include="MagStripeDemo.Main.pas"><Form>MagStripeForm</Form><FormType>dfm</FormType></DCCReference>
    <DCCReference Include="..\shared\ERD.Card.Demo.Form.pas"/>
    <DCCReference Include="..\shared\ERD.Card.Demo.Job.pas"/>
    <DCCReference Include="..\shared\ERD.Card.Demo.Operations.pas"/>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <BuildConfiguration Include="Debug"><Key>Cfg_1</Key><CfgParent>Base</CfgParent></BuildConfiguration>
    <BuildConfiguration Include="Release"><Key>Cfg_2</Key><CfgParent>Base</CfgParent></BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType/>
    <BorlandProject><Delphi.Personality><Source><Source Name="MainSource">MagStripeDemo.dpr</Source></Source></Delphi.Personality>
      <Platforms><Platform value="Win32">True</Platform><Platform value="Win64">True</Platform></Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets"/>
</Project>
