<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{77C5B8B7-6C11-5DEF-951A-8E5ED5AFA3B4}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="magstripe\MagStripeDemo.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="smartcard\SmartCardDemo.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="MagStripeDemo">
        <MSBuild Projects="magstripe\MagStripeDemo.dproj"/>
    </Target>
    <Target Name="MagStripeDemo:Clean">
        <MSBuild Projects="magstripe\MagStripeDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="MagStripeDemo:Make">
        <MSBuild Projects="magstripe\MagStripeDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="SmartCardDemo">
        <MSBuild Projects="smartcard\SmartCardDemo.dproj"/>
    </Target>
    <Target Name="SmartCardDemo:Clean">
        <MSBuild Projects="smartcard\SmartCardDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SmartCardDemo:Make">
        <MSBuild Projects="smartcard\SmartCardDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="MagStripeDemo;SmartCardDemo"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="MagStripeDemo:Clean;SmartCardDemo:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="MagStripeDemo:Make;SmartCardDemo:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
