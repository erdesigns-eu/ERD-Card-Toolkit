unit ERD.Card.ATR.Legacy;

{$IFDEF FPC}
{$MODE DELPHI}
{$ENDIF}

interface


type
  /// <summary>One original CardStudio report, containing a complete valid asynchronous ATR.</summary>
  /// <remarks>Issuer/scheme/country are unverified historical observations, not authenticated identities.</remarks>
  TLegacyAtrReport = record
    /// <summary>Original historical atrhex value.</summary>
    AtrHex: string;

    /// <summary>Original historical scheme value.</summary>
    Scheme: string;

    /// <summary>Original historical cardtype value.</summary>
    CardType: string;

    /// <summary>Original historical country value.</summary>
    Country: string;

    /// <summary>Original historical issuer value.</summary>
    Issuer: string;

    /// <summary>Original historical category value.</summary>
    Category: string;

    /// <summary>One-based original untATRList.pas record index, preserved after malformed records were removed.</summary>
    SourceRow: Integer;
  end;

  /// <summary>Owned ordered historical reports; duplicate fingerprints remain separate observations.</summary>
  TLegacyAtrReports = array of TLegacyAtrReport;

  /// <summary>Original report inventory, with strictly validated ATRs and no corrections to source data.</summary>
  TLegacyAtrCatalog = class
  public
    /// <summary>Returns the 1316 valid original reports, with only valid complete ATRs.</summary>
    /// <returns>Independent array with original source-row references.</returns>
    class function GetReports: TLegacyAtrReports; static;
  end;

implementation

