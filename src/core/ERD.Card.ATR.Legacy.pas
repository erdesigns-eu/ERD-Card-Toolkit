class function TLegacyAtrCatalog.GetReports: TLegacyAtrReports;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(StoredReports));
  for I := 0 to High(StoredReports) do
  begin
    Result[I].AtrHex := StoredReports[I].AtrHex;
    Result[I].Scheme := StoredReports[I].Scheme;
    Result[I].CardType := StoredReports[I].CardType;
    Result[I].Country := StoredReports[I].Country;
    Result[I].Issuer := StoredReports[I].Issuer;
    Result[I].Category := StoredReports[I].Category;
    Result[I].SourceRow := StoredReports[I].SourceRow;
  end;
end;

end.
