unit ERD.Card.ATR.Catalog;

{$IFDEF FPC}
  {$MODE DELPHI}
{$ENDIF}

interface

uses
{$IFDEF FPC}
  SysUtils,
{$ELSE}
  System.SysUtils,
{$ENDIF}
  ERD.Card.ATR;

const
  /// <summary>Maximum caller-supplied ATR entries in one bounded catalog.</summary>
  AtrCatalogMaxEntries = 512;

type
  /// <summary>Invalid catalog metadata, duplicate identifier or masked pattern.</summary>
  EAtrCatalogError = class(EConvertError);
  /// <summary>Scope of a non-authenticated ATR recognition hint.</summary>
  TAtrHintKind = (
    /// <summary>Reader-reported protocol family, with masked card-name/checksum positions.</summary>
    ahkFamily,
    /// <summary>Exact documented reader-reported card name, potentially shared by other chips/emulations.</summary>
    ahkReportedModel
  );
  /// <summary>One caller-supplied ATR recognition rule, bounded to AtrMaxSize bytes.</summary>
  /// <remarks>Every byte compares (input and Mask) to Pattern. Pattern bits outside Mask must be zero.
  /// Array assignment shares buffers; catalog construction copies them independently.</remarks>
  TAtrCatalogEntry = record
    /// <summary>Stable unique nonempty identifier, at most 128 characters.</summary>
    Id: string;
    /// <summary>Human-readable advisory label, at most 256 characters.</summary>
    Description: string;
    /// <summary>Protocol-family or reader-reported-model scope.</summary>
    Kind: TAtrHintKind;
    /// <summary>Anchored full-length masked pattern, two through 33 bytes.</summary>
    Pattern: TBytes;
    /// <summary>Same-length bit mask; at least one significant bit.</summary>
    Mask: TBytes;
    /// <summary>Required provenance/document reference, at most 1024 characters.</summary>
    Source: string;
  end;
  /// <summary>Caller-owned array of catalog entry definitions; copied by the catalog constructor.</summary>
  TAtrCatalogEntries = array of TAtrCatalogEntry;
  /// <summary>One matching advisory hint, without card data or a support/identity assertion.</summary>
  TAtrCatalogMatch = record
    /// <summary>Matching entry identifier.</summary>
    Id: string;
    /// <summary>Advisory protocol/card-name description.</summary>
    Description: string;
    /// <summary>Family versus reported-model scope.</summary>
    Kind: TAtrHintKind;
    /// <summary>Provenance for assessing the hint.</summary>
    Source: string;
  end;
  /// <summary>All matching hints in catalog order; empty means unknown, never guessed.</summary>
  TAtrCatalogMatches = array of TAtrCatalogMatch;
  /// <summary>Immutable, bounded, source-attributed ATR catalog; performs no I/O.</summary>
  /// <remarks>Validates the ATR before matching; includes all overlapping hints rather than picking
  /// one issuer/model. ATRs can be shared, emulated or generated by readers; hints do not authorize
  /// card operations or prove identity. Concurrent read-only lookup does not mutate the catalog.</remarks>
  TAtrCatalog = class
  private
    FEntries: TAtrCatalogEntries;
  public
    /// <summary>Copies and validates a caller-supplied catalog.</summary>
    /// <param name="AEntries">Zero through AtrCatalogMaxEntries entries with unique IDs and required provenance.</param>
    /// <exception cref="EAtrCatalogError">Metadata, masks, count or identifiers are invalid.</exception>
    constructor Create(const AEntries: TAtrCatalogEntries);
    /// <summary>Returns every anchored masked match for a completely validated ATR.</summary>
    /// <param name="AAtr">Complete logical ATR, including required TCK.</param>
    /// <returns>Independent ordered hints; empty for an unknown valid ATR.</returns>
    /// <exception cref="EAtrFormatError">ATR syntax or checksum is invalid before any matching.</exception>
    function FindMatches(const AAtr: TBytes): TAtrCatalogMatches;
  end;

/// <summary>Creates an owned catalog of ACS 1.09 PC/SC storage-family and documented card-name hints.</summary>
/// <returns>Inactive immutable catalog; caller must Free.</returns>
/// <remarks>Curated protocol facts, not the legacy issuer database. Classic fingerprints are shared
/// by Plus/SmartMX emulations; SLIX/SLIX2 also share a fingerprint. All overlapping hints are retained.</remarks>
function CreateDefaultAtrCatalog: TAtrCatalog;

implementation

uses ERD.Card.Bytes;

procedure InvalidCatalog;
begin raise EAtrCatalogError.Create('Invalid or unsupported ATR catalog definition.'); end;

constructor TAtrCatalog.Create(const AEntries: TAtrCatalogEntries);
var I,J,N:Integer; Nonzero:Boolean;
begin
  inherited Create;
  if Length(AEntries)>AtrCatalogMaxEntries then InvalidCatalog;
  SetLength(FEntries,Length(AEntries));
  for I:=0 to High(AEntries) do
  begin
    if (Length(AEntries[I].Id)<1) or (Length(AEntries[I].Id)>128) or
      (Length(AEntries[I].Description)<1) or (Length(AEntries[I].Description)>256) or
      (Length(AEntries[I].Source)<1) or (Length(AEntries[I].Source)>1024) or
      (Ord(AEntries[I].Kind)<Ord(Low(TAtrHintKind))) or
      (Ord(AEntries[I].Kind)>Ord(High(TAtrHintKind))) then InvalidCatalog;
    N:=Length(AEntries[I].Pattern);
    if (N<2) or (N>AtrMaxSize) or (Length(AEntries[I].Mask)<>N) then InvalidCatalog;
    Nonzero:=False;
    for J:=0 to N-1 do
    begin
      if (AEntries[I].Pattern[J] and not AEntries[I].Mask[J])<>0 then InvalidCatalog;
      if AEntries[I].Mask[J]<>0 then Nonzero:=True;
    end;
    if not Nonzero then InvalidCatalog;
    for J:=0 to I-1 do if FEntries[J].Id=AEntries[I].Id then InvalidCatalog;
    FEntries[I]:=AEntries[I];
    FEntries[I].Pattern:=CopyBytes(AEntries[I].Pattern); FEntries[I].Mask:=CopyBytes(AEntries[I].Mask);
  end;
end;

function TAtrCatalog.FindMatches(const AAtr:TBytes):TAtrCatalogMatches;
var Atr:TAtrInfo; I,J,N:Integer; Matches:Boolean;
begin
  Result:=nil; Atr:=TAtrCodec.Decode(AAtr);
  for I:=0 to High(FEntries) do
  begin
    if Length(FEntries[I].Pattern)<>Length(Atr.Raw) then Continue;
    Matches:=True;
    for J:=0 to High(Atr.Raw) do if (Atr.Raw[J] and FEntries[I].Mask[J])<>FEntries[I].Pattern[J] then
    begin Matches:=False; Break; end;
    if Matches then
    begin
      N:=Length(Result); SetLength(Result,N+1); Result[N].Id:=FEntries[I].Id;
      Result[N].Description:=FEntries[I].Description; Result[N].Kind:=FEntries[I].Kind; Result[N].Source:=FEntries[I].Source;
    end;
  end;
end;

function CreateDefaultAtrCatalog:TAtrCatalog;
var E:TAtrCatalogEntries; N:Integer;
  procedure Exact(const Id,LabelText,Hex:string);
  var J:Integer;
  begin
    N:=Length(E); SetLength(E,N+1); E[N].Id:=Id; E[N].Description:=LabelText;
    E[N].Kind:=ahkReportedModel; E[N].Pattern:=HexToBytes(Hex); SetLength(E[N].Mask,Length(E[N].Pattern));
    for J:=0 to High(E[N].Mask) do E[N].Mask[J]:=$FF;
    E[N].Source:='ACS ACR1552U Series Reference Manual 1.09, section 5.3.8; reader-reported hint only';
  end;
begin
  E:=nil;
  Exact('acs-iso15693-generic','Reader-reported generic ISO 15693','3B8F8001804F0CA0000003060B00000000000063');
  Exact('acs-myd-vicinity','Reader-reported Infineon My-D Vicinity','3B8F8001804F0CA0000003060B000E000000006D');
  Exact('acs-st-lri','Reader-reported ST LRI','3B8F8001804F0CA0000003060B00130000000070');
  Exact('acs-icode-sli','Reader-reported NXP I-Code SLI','3B8F8001804F0CA0000003060B00140000000077');
  Exact('acs-icode-slix','Reader-reported NXP I-Code SLIX/SLIX2','3B8F8001804F0CA0000003060B00350000000056');
  Exact('acs-classic-1k','Reader-reported Classic 1K / Plus SL1 2K / SmartMX emulation','3B8F8001804F0CA000000306030001000000006A');
  Exact('acs-classic-4k','Reader-reported Classic 4K / Plus SL1 4K / SmartMX emulation','3B8F8001804F0CA0000003060300020000000069');
  Exact('acs-ultralight','Reader-reported Ultralight or configured compatible emulation','3B8F8001804F0CA0000003060300030000000068');
  Exact('acs-ultralight-ev1','Reader-reported Ultralight EV1','3B8F8001804F0CA00000030603003D0000000056');
  N:=Length(E); SetLength(E,N+1); E[N]:=E[0];
  E[N].Id:='pcsc-iso15693-family'; E[N].Description:='PC/SC storage ATR indicating the ISO 15693 family';
  E[N].Kind:=ahkFamily; E[N].Pattern:=CopyBytes(E[0].Pattern); E[N].Mask:=CopyBytes(E[0].Mask);
  // The card-name bytes and TCK vary together; syntax/TCK are validated before matching.
  E[N].Pattern[13]:=0; E[N].Pattern[14]:=0; E[N].Pattern[19]:=0;
  E[N].Mask[13]:=0; E[N].Mask[14]:=0; E[N].Mask[19]:=0;
  Result:=TAtrCatalog.Create(E);
end;

end.
