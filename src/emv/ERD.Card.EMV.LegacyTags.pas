class function TLegacyEmvTagCatalog.FindByPath(const APathHex: string): TLegacyEmvTags;
var
  Text: string;
  I, J, N: Integer;
  Match: Boolean;
begin
  Result := nil;
  Text := UpperCase(APathHex);
  if (Length(Text) < 2) or (Length(Text) > 8) or (Length(Text) mod 2 <> 0) then
    raise EConvertError.Create('Invalid historical EMV tag path.');
  for J := 1 to Length(Text) do
    if not CharInSet(Text[J], ['0' .. '9', 'A' .. 'F']) then
      raise EConvertError.Create('Invalid historical EMV tag path.');
  for I := 0 to High(Tags) do
  begin
    Match := Length(Text) = Length(Tags[I].PatternHex);
    if Match then
      for J := 1 to Length(Text) do
        if not CharInSet(Tags[I].PatternHex[J], ['X', 'Y']) and
          (Text[J] <> Tags[I].PatternHex[J]) then
        begin
          Match := False;
          Break;
        end;
    if Match then
    begin
      N := Length(Result);
      SetLength(Result, N + 1);
      Result[N] := Tags[I];
    end;
  end;
end;

class function TLegacyEmvTagCatalog.GetEntries: TLegacyEmvTags;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(Tags));
  for I := 0 to High(Tags) do
    Result[I] := Tags[I];
end;

end.
