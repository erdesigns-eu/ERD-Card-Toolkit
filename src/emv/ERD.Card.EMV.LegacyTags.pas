unit ERD.Card.EMV.LegacyTags;

{$IFDEF FPC}
{$MODE DELPHI}
{$ENDIF}

interface

uses
{$IFDEF FPC}
  SysUtils;
{$ELSE}
  System.SysUtils;
{$ENDIF}

type
  /// <summary>Historical tag label from CardStudio; private identifiers depend on the issuer context.</summary>
  TLegacyEmvTag = record
    /// <summary>Historical identifier or nested tag path, stored as an integer; zero for symbolic patterns.</summary>
    Tag: Cardinal;

    /// <summary>Original tag/path text, including X/Y symbolic index nibbles.</summary>
    PatternHex: string;

    /// <summary>Unverified historical description; not a value-decoding contract.</summary>
    Name: string;
  end;

  /// <summary>Owned ordered historical labels, including conflicting descriptions.</summary>
  TLegacyEmvTags = array of TLegacyEmvTag;

  /// <summary>Source-attributed original tag inventory.</summary>
  TLegacyEmvTagCatalog = class
  public
    /// <summary>Returns all 515 original tag labels without collapsing issuer-specific alternatives.</summary>
    /// <returns>Independent ordered array.</returns>
    class function GetEntries: TLegacyEmvTags; static;

    /// <summary>Returns historical labels for an exact encoded tag path, including symbolic X/Y indices.</summary>
    /// <param name="APathHex">Even-length hexadecimal tag/path text, two through eight characters.</param>
    /// <returns>Independent historical alternatives; no BER decoding or issuer identity is inferred.</returns>
    class function FindByPath(const APathHex: string): TLegacyEmvTags; static;
  end;

implementation

