interface

type
  /// <summary>One bundled metro or premetro station keyed by event provider, zone, sub-zone and station.</summary>
  TMobibBrusselsStation = record
    /// <summary>Five-bit event provider code: 0 metro, 7 premetro.</summary>
    Provider: Byte;
    /// <summary>Six-bit zone of the seventeen-bit location.</summary>
    Zone: Byte;
    /// <summary>Four-bit sub-zone of the seventeen-bit location.</summary>
    SubZone: Byte;
    /// <summary>Seven-bit station of the seventeen-bit location.</summary>
    Station: Byte;
    /// <summary>Metro line label as published by the source table.</summary>
    Line: string;
    /// <summary>Station name; non-ASCII characters use \uXXXX escapes.</summary>
    Name: string;
  end;

  /// <summary>One bundled bus stop keyed by bus line and twelve-bit stop code.</summary>
  TMobibBrusselsBusStop = record
    /// <summary>Bus line number.</summary>
    Line: Word;
    /// <summary>Twelve-bit stop code from the event bus-location field.</summary>
    Code: Word;
    /// <summary>Stop name; non-ASCII characters use \uXXXX escapes.</summary>
    Name: string;
    /// <summary>Line direction (terminus) for this stop code.</summary>
    Direction: string;
  end;

