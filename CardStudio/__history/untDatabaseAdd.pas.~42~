unit untDatabaseAdd;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Imaging.pngimage,
  Vcl.ExtCtrls, Vcl.ComCtrls;

type
  TfrmDatabaseAdd = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnCancel: TButton;
    btnOK: TButton;
    PC: TPageControl;
    TabSheet1: TTabSheet;
    TabSheet2: TTabSheet;
    panel4: TPanel;
    Panel5: TPanel;
    gbCountry: TGroupBox;
    cbCountry: TComboBox;
    gbCurrency: TGroupBox;
    cbCurrency: TComboBox;
    pnlCardHolder: TPanel;
    gbFirstName: TGroupBox;
    edtFirstName: TEdit;
    gbLastName: TGroupBox;
    edtLastName: TEdit;
    Panel6: TPanel;
    GroupBox1: TGroupBox;
    cbExpirationYear: TComboBox;
    GroupBox2: TGroupBox;
    cbExpirationMonth: TComboBox;
    Panel7: TPanel;
    gbScheme: TGroupBox;
    cbScheme: TComboBox;
    gbType: TGroupBox;
    cbType: TComboBox;
    gbIssuer: TGroupBox;
    edtIssuer: TEdit;
    gbIssuerURL: TGroupBox;
    edtIssuerURL: TEdit;
    Panel3: TPanel;
    gbPAN: TGroupBox;
    edtPAN: TEdit;
    gbCategory: TGroupBox;
    edtCategory: TEdit;
    gbCVV: TGroupBox;
    edtCVV: TEdit;
    gbPIN: TGroupBox;
    edtPIN: TEdit;
    TabSheet3: TTabSheet;
    GridPanel1: TGridPanel;
    gbTrack1: TGroupBox;
    memTrack1: TMemo;
    gbTrack2: TGroupBox;
    memTrack2: TMemo;
    gbTrack3: TGroupBox;
    memTrack3: TMemo;
    memComment: TMemo;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnOKClick(Sender: TObject);
    procedure btnCancelClick(Sender: TObject);
  private
    { Private declarations }
    FDatabaseFile : string;
  public
    { Public declarations }
    property DatabaseFile: string read FDatabaseFile write FDatabaseFile;

    procedure LoadFromTracks(const T1: string; const T2: string; T3: string);
  end;

var
  frmDatabaseAdd: TfrmDatabaseAdd;

implementation

{$R *.dfm}

uses untConst, untBIN, SQLite3, SQLite3Wrap, Registry, untDatabase,
     System.RegularExpressions;

{*******************************************************}
{                Load Data from Tracks                  }
{*******************************************************}
procedure TfrmDatabaseAdd.LoadFromTracks(const T1: string; const T2: string; T3: string);

  {*******************************************************}
  {                    Parse Track 1                      }
  {*******************************************************}
  procedure ParseTrack1(const Track: string);

    function IsValidData : Boolean;
    begin
      Result := TRegEx.IsMatch(Track, Track1RegEx);
    end;

    function PAN : string;
    var
      PS, PE : Integer;
    begin
      // Start Position
      PS := 1;
      // If there is a start sentinel, move the start position
      if (Track[PS] = MST1StartSentinel) then Inc(PS);
      // If the first character is a B, move the start position
      if (Track[PS] = 'B') then Inc(PS);
      // Get the position of the field seperator
      PE := Pos(Track1FieldSeperator, Track) - PS;
      // Extract PAN from track
      Result := Copy(Track, PS, PE);
    end;

    function CardHolder(const FirstName: Boolean) : string;
    var
      PS, PE : Integer;
      FullNm : string;
    begin
      // Start Position
      PS := Pos(Track1FieldSeperator, Track);
      // Get the position of the field seperator
      PE := Pos(Track1FieldSeperator, Track, PS + 1) - PS;
      // Extract Name from track
      FullNm := Copy(Track, PS +1, PE -1);
      if (Pos(Track1NameSeperator, FullNm) > 0) then
      begin
        PE := Pos(Track1NameSeperator, FullNm);
        if FirstName then
          Result := Trim(Copy(FullNm, PE +1, Length(FullNm)))
        else
          Result := Trim(Copy(FullNm, 1, PE -1));
      end else
      begin
        if FirstName then
          Result := ''
        else
          Result := Trim(FullNm);
      end;
    end;

    function AditionalData : string;
    var
      PS : Integer;
    begin
      PS := Pos(Track1FieldSeperator, Track);
      PS := Pos(Track1FieldSeperator, Track, PS +1);
      Result := Copy(Track, PS +1, Length(Track));
    end;

    function ExpiryYear : String;
    var
      X : Integer;
    begin
      if TryStrToInt(Copy(AditionalData, 1, 2), X) then
      begin
        Result := Format('%d', [2000 + X]);
      end else
        Result := '2000';
    end;

    function ExpiryMonth : string;
    var
      X : Integer;
    begin
      if TryStrToInt(Copy(AditionalData, 3, 2), X) then
      begin
        Result := Format('%.*d (%s)', [2, X, LongMonthNames[X]]);
      end else
        Result := LongMonthNames[1];
    end;

    function CVV : Integer;
    var
      S : string;
    begin
      S := AditionalData;
      Result := StrToInt(Copy(S, Length(S) - 8, 3));
    end;

  var
    P, B : string;
    C    : TCardScheme;
    X    : Integer;
  begin
    // Check if data is valid Track 1
    if IsValidData then
    begin
      // PAN
      P := PAN;
      edtPAN.Text := PAN;
      // Card Scheme
      C := FindCardScheme(P);
      cbScheme.ItemIndex := cbScheme.Items.IndexOf(CardSchemeToStr(C));
      // First Name
      edtFirstName.Text := CardHolder(True);
      // Last Name
      edtLastName.Text := CardHolder(False);
      // Exp Year
      cbExpirationYear.ItemIndex := cbExpirationYear.Items.IndexOf(ExpiryYear);
      // Exp Month
      cbExpirationMonth.ItemIndex := cbExpirationMonth.Items.IndexOf(ExpiryMonth);
    end;

    // Parse / Decode track data
    with memTrack1.Lines do
    begin
      // Begin Update
      BeginUpdate;
      // Log Header
      Add(Format(TrackLogHeader, [1]));

      // Save PAN for decoder
      DecoderPAN := P;
      // Find card scheme

      Add(Format(TrackLogPAN, [FormatPAN(P, C), CardSchemeToStr(C), IfThen(IsLuhnValid(P), TrackLogLUHNValid, TrackLogLUHNInValid)]));
      // BIN
      B := FormatBIN(C, P);
      if Length(B) > 0 then Add(B);
      // Card Holder
      Add(Format(TrackLogName, [, CardHolder(False)]));
      // Expiry
      Add(Format(TrackLogEXP, []));
      // Service Code
      X := ServiceCode;
      Add(Format(TrackLogSC, [3, X, ServiceCodeDigit(X, 1), ServiceCodeDigit(X, 2), ServiceCodeDigit(X, 3)]));
      // PVKI
      Add(Format(TrackLogPVKI, [PVKI]));
      // PVV
      Add(Format(TrackLogPVV, [4, PVV]));
      // CVV
      Add(Format(TrackLogCVV, [3, CVV]));
      // End Update
      EndUpdate;
    end;
  end;

begin


end;

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmDatabaseAdd.FormCreate(Sender: TObject);
var
  R : TRegistry;
  I : Integer;
begin
  R := TRegistry.Create;
  try
    R.RootKey := HKEY_CURRENT_USER;
    if R.OpenKey(ApplicationRegKey, True) then
    begin
      // Database File
      if R.ValueExists(DBFile) then DatabaseFile := R.ReadString(DBFile)
    end;
  finally
    R.Free;
  end;
  // Set width and height
  Width  := 640;
  Height := 530;
  // Set page 1
  PC.ActivePageIndex := 0;
  // Clear memo's
  memTrack1.Clear;
  memTrack2.Clear;
  memTrack3.Clear;
  memComment.Clear;
  // Card Schemes
  for I := Low(CardSchemes) to High(CardSchemes) do
  cbScheme.Items.AddObject(CardSchemeToStr(CardSchemes[I]), TObject(CardSchemes[I]));
  cbScheme.ItemIndex := 0;
  // Card Types
  for I := Low(CardTypes) to High(CardTypes) do
  cbType.Items.AddObject(CardTypeToStr(CardTypes[I]), TObject(CardTypes[I]));
  cbType.ItemIndex := 0;
  // Countries
  for I := Low(CountryCodes) to High(CountryCodes) do
  cbCountry.Items.AddObject(CountryCodeToStr(CountryCodes[I]), TObject(CountryCodes[I]));
  cbCountry.ItemIndex := 0;
  // Currency Codes
  for I := Low(CurrencyCodes) to High(CurrencyCodes) do
  cbCurrency.Items.AddObject(CurrencyCodeToStr(CurrencyCodes[I]), TObject(CurrencyCodes[I]));
  cbCurrency.ItemIndex := 0;
  // Years
  for I := 0 to 10 do
  cbExpirationYear.Items.Add(Format('%.*d', [4, CurrentYear + I]));
  cbExpirationYear.ItemIndex := 0;
  // Months
  for I := Low(LongMonthNames) to High(LongMonthNames) do
  cbExpirationMonth.Items.Add(LongMonthNames[I]);
  cbExpirationMonth.ItemIndex := 0;
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmDatabaseAdd.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Action := caFree;
  Release;
end;

{*******************************************************}
{                   Add to Database                     }
{*******************************************************}
procedure TfrmDatabaseAdd.btnOKClick(Sender: TObject);
var
  DB : TSQLite3Database;
  ST : TSQLite3Statement;
begin
  DB := TSQLite3Database.Create;
  try
    DB.Open(DatabaseFile);
    ST := DB.Prepare(DBAddCard);
    ST.BindText(1, edtPAN.Text);
    ST.BindInt(2, TCardScheme(cbScheme.Items.Objects[cbScheme.ItemIndex]));
    ST.BindInt(3, TCardType(cbType.Items.Objects[cbType.ItemIndex]));
    ST.BindText(4, edtCategory.Text);
    ST.BindText(5, edtIssuer.Text);
    ST.BindText(6, edtIssuerURL.Text);
    ST.BindInt(7, TCountryCode(cbCountry.Items.Objects[cbCountry.ItemIndex]));
    ST.BindInt(8, TCurrencyCode(cbCurrency.Items.Objects[cbCurrency.ItemIndex]));
    ST.BindText(9, edtFirstName.Text);
    ST.BindText(10, edtLastName.Text);
    ST.BindInt(11, StrToInt(cbExpirationYear.Text));
    ST.BindInt(12, cbExpirationMonth.ItemIndex +1);
    ST.BindText(13, memTrack1.Text);
    ST.BindText(14, memTrack2.Text);
    ST.BindText(15, memTrack3.Text);
    ST.BindText(16, edtCVV.Text);
    ST.BindText(17, edtPIN.Text);
    ST.BindText(18, memComment.Text);
    // Add to table
    ST.StepAndReset;
    // Update list with CCS in browser
    if Assigned(frmDatabase) then frmDatabase.ExecuteQuery(DBSelectCards);
  finally
    DB.Free;
  end;
  // Close window
  Close;
end;

{*******************************************************}
{                       Cancel                          }
{*******************************************************}
procedure TfrmDatabaseAdd.btnCancelClick(Sender: TObject);
begin
  Close;
end;

end.
