unit untGPSecurity;

interface

uses
  WinApi.Windows;

const
  OP_201 = 201; //!< OpenPlatform specification 2.0.1' mode
  GP_211 = 211; //!< GlobalPlatform specification 2.1.1 mode

  // Secure Channel stuff

  GP211_SCP01 = $01; //!< Secure Channel Protocol '01'
  GP211_SCP02 = $02; //!< Secure Channel Protocol '02'
  GP211_SCP03 = $03; //!< Secure Channel Protocol '03'

  (** Secure Channel Protocol '01': "i" '05': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, no ICV encryption, 3 Secure Channel Keys
    *)
  GP211_SCP01_IMPL_i05 = $05;

  (** Secure Channel Protocol '01': "i" '15': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, ICV encryption, 3 Secure Channel Keys
    *)
  GP211_SCP01_IMPL_i15 = $15;

  (** Secure Channel Protocol '02': "i" = '44': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, no ICV encryption, 1 Secure Channel base key,
    * well-known pseudo-random algorithm (card challenge),
    *)
  GP211_SCP02_IMPL_i44 = $44;

  (** Secure Channel Protocol '02': "i" = '45': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, no ICV encryption, 3 Secure Channel Keys,
    * well-known pseudo-random algorithm (card challenge),
    *)
  GP211_SCP02_IMPL_i45 = $45;

  (** Secure Channel Protocol '02': "i" = '54': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, ICV encryption for C-MAC session, 1 Secure Channel base key,
    * well-known pseudo-random algorithm (card challenge),
    *)
  GP211_SCP02_IMPL_i54 = $54;

  (** Secure Channel Protocol '02': "i" = '55': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, ICV encryption for C-MAC session, 3 Secure Channel Keys,
    * well-known pseudo-random algorithm (card challenge).
    *)
  GP211_SCP02_IMPL_i55 = $55;

  (** Secure Channel Protocol '02': "i" '04': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, no ICV encryption, 1 Secure Channel base key, unspecified card challenge generation method
    *)
  GP211_SCP02_IMPL_i04 = $04;

  (** Secure Channel Protocol '02': "i" '05': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, no ICV encryption, 3 Secure Channel Keys, unspecified card challenge generation method
    *)
  GP211_SCP02_IMPL_i05 = $05;

  (** Secure Channel Protocol '02': "i" '0A': Initiation mode implicit, C-MAC on unmodified APDU,
    * ICV set to MAC over AID, no ICV encryption, 1 Secure Channel base key
    *)
  GP211_SCP02_IMPL_i0A = $0A;

  (** Secure Channel Protocol '02': "i" '0B': Initiation mode implicit, C-MAC on unmodified APDU,
    * ICV set to MAC over AID, no ICV encryption, 3 Secure Channel Keys
    *)
  GP211_SCP02_IMPL_i0B = $0B;

  (** Secure Channel Protocol '02': "i" '14': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, ICV encryption for CMAC session, 1 Secure Channel base key,
    * unspecified card challenge generation method
    *)
  GP211_SCP02_IMPL_i14 = $14;

  (** Secure Channel Protocol '02': "i" '15': Initiation mode explicit, C-MAC on modified APDU,
    * ICV set to zero, ICV encryption for CMAC session, 3 Secure Channel Keys,
    * unspecified card challenge generation method
    *)
  GP211_SCP02_IMPL_i15 = $15;

  (** Secure Channel Protocol '02': "i" '1A': Initiation mode implicit, C-MAC on unmodified APDU,
    * ICV set to MAC over AID, ICV encryption for C-MAC session, 1 Secure Channel base key
    *)
  GP211_SCP02_IMPL_i1A = $1A;

  (** Secure Channel Protocol '02': "i" '1B': Initiation mode implicit, C-MAC on unmodified APDU,
    * ICV set to MAC over AID, ICV encryption for C-MAC session, 3 Secure Channel Keys
    *)
  GP211_SCP02_IMPL_i1B = $1B;

  (** Secure Channel Protocol '03': "i" '00': Random card challenge, No R-MAC, no R-ENCRYPTION.
    *)
  GP211_SCP03_IMPL_i00 = $00;

  (**
	  * Secure Channel Protocol '03': "i" '10': Pseudo-random card challenge, no R-MAC support, no R-ENCRYPTION support.
	  *)
  GP211_SCP03_IMPL_i10 = $10;

  (**
	  * Secure Channel Protocol '03': "i" '30': Pseudo-random card challenge, R-MAC support, no R-ENCRYPTION support.
	  *)
  GP211_SCP03_IMPL_i30 = $30;

  (**
	  * Secure Channel Protocol '03': "i" '20': Random card challenge, R-MAC support, no R-ENCRYPTION support.
	  *)
  GP211_SCP03_IMPL_i20 = $20;

  (**
	  * Secure Channel Protocol '03': "i" '60': Random card challenge, R-MAC support, R-ENCRYPTION support.
   	*)
  GP211_SCP03_IMPL_i60 = $60;

  (**
	  * Secure Channel Protocol '03': "i" '70': Pseudo-random card challenge, R_MAC, support, R-ENCRYPTION support.
	  *)
  GP211_SCP03_IMPL_i70 = $70;

  GP211_SCP01_SECURITY_LEVEL_C_DEC_C_MAC             = $03; //!< Secure Channel Protocol '01': C-DECRYPTION and C-MAC
  GP211_SCP01_SECURITY_LEVEL_C_MAC                   = $01; //!< Secure Channel Protocol '01': C-MAC
  GP211_SCP01_SECURITY_LEVEL_NO_SECURE_MESSAGING     = $00; //!< Secure Channel Protocol '01': No secure messaging expected.

  GP211_SCP02_SECURITY_LEVEL_C_DEC_C_MAC_R_MAC       = $13; //!< Secure Channel Protocol '02': C-DECRYPTION, C-MAC and R-MAC
  GP211_SCP02_SECURITY_LEVEL_C_MAC_R_MAC             = $11; //!< Secure Channel Protocol '02': C-MAC and R-MAC
  GP211_SCP02_SECURITY_LEVEL_R_MAC                   = $10; //!< Secure Channel Protocol '02': R-MAC. Used only with BEGIN R-MAC.
  GP211_SCP02_SECURITY_LEVEL_C_DEC_C_MAC             = $03; //!< Secure Channel Protocol '02': C-DECRYPTION and C-MAC
  GP211_SCP02_SECURITY_LEVEL_C_MAC                   = $01; //!< Secure Channel Protocol '02': C-MAC
  GP211_SCP02_SECURITY_LEVEL_NO_SECURE_MESSAGING     = $00; //!< Secure Channel Protocol '02': No secure messaging expected.

   // Philip Wendland: added SCP03 security level identifiers
  GP211_SCP03_SECURITY_LEVEL_C_DEC_C_MAC             = $03; //!< Secure Channel Protocol '03': C-Decryption and C-MAC
  GP211_SCP03_SECURITY_LEVEL_C_MAC                   = $01; //!< Secure Channel Protocol '03': C-MAC
  GP211_SCP03_SECURITY_LEVEL_NO_SECURE_MESSAGING     = $00; //!< Secure Channel Protocol '03': No secure messaging expected.
  GP211_SCP03_SECURITY_LEVEL_C_DEC_R_ENC_C_MAC_R_MAC = $33; //!< Secure Channel Protocol '03': C-Decryption, C-MAC, R-MAC and R-Encryption
  GP211_SCP03_SECURITY_LEVEL_C_DEC_C_MAC_R_MAC       = $13; //!< Secure Channel Protocol '03': C-Decryption, C-MAC and R-MAC
  GP211_SCP03_SECURITY_LEVEL_C_DEC_C_MAC_R_ENC_R_MAC = $33; //!< Secure Channel Protocol '03': C-Decryption, C-MAC, R-Encryption and R-MAC
  GP211_SCP03_SECURITY_LEVEL_C_MAC_R_MAC             = $11; //!< Secure Channel Protocol '03': C-MAC and R-MAC
  GP211_SCP03_SECURITY_LEVEL_R_MAC                   = $10; //!< Secure Channel Protocol '03': R-MAC. Used only with BEGIN R-MAC.
  GP211_SCP03_SECURITY_LEVEL_R_ENC_R_MAC             = $30; //!< Secure Channel Protocol '03': R-Encryption and R-MAC. Used only with BEGIN R-MAC.

  GP211_KEY_TYPE_RSA_PUB_N                           = $A1; //!< 'A1' RSA Public Key - modulus N component (clear text).
  GP211_KEY_TYPE_RSA_PUB_E                           = $A0; //!< 'A0' RSA Public Key - public exponent e component (clear text)
  GP211_KEY_TYPE_RSA_PRIV_N                          = $A2; //!< 'A2' RSA Private Key - modulus N component
  GP211_KEY_TYPE_RSA_PRIV_D                          = $A3; //!< 'A3' RSA Private Key - private exponent d component
  GP211_KEY_TYPE_RSA_PRIV_P                          = $A4; //!< 'A4' RSA Private Key - Chinese Remainder P component
  GP211_KEY_TYPE_RSA_PRIV_Q                          = $A5; //!< 'A5' RSA Private Key - Chinese Remainder Q component
  GP211_KEY_TYPE_RSA_PRIV_PQ                         = $A6; //!< 'A6' RSA Private Key - Chinese Remainder PQ component
  GP211_KEY_TYPE_RSA_PRIV_DP1                        = $A7; //!< 'A7' RSA Private Key - Chinese Remainder DP1 component
  GP211_KEY_TYPE_RSA_PRIV_DQ1                        = $A8; //!< 'A8' RSA Private Key - Chinese Remainder DQ1 component

  GP211_KEY_TYPE_3DES                                = $81; //!< Reserved (triple DES).
  GP211_KEY_TYPE_DES                                 = $80; //!< '80' DES mode (EBC/CBC) implicitly known.
  GP211_KEY_TYPE_3DES_CBC                            = $82; //!< '82' Triple DES in CBC mode.
  GP211_KEY_TYPE_DES_ECB                             = $83; //!< '83' DES in ECB mode.
  GP211_KEY_TYPE_DES_CBC                             = $84; //!< '84' DES in CBC mode.
  GP211_KEY_TYPE_PSK_TLS                             = $85; //!< '85' Pre-Shared Key for Transport Layer Security
  GP211_KEY_TYPE_AES                                 = $88; //!< '88' AES (16, 24, or 32 long keys)

  OP201_SECURITY_LEVEL_ENC_MAC                       = $03; //!< Command messages are signed and encrypted.
  OP201_SECURITY_LEVEL_MAC                           = $01; //!< Command messages are signed.
  OP201_SECURITY_LEVEL_PLAIN                         = $00; //!< Command messages are plain text.

  OP201_KEY_TYPE_RSA_PUP_N                           = $A1; //!< 'A1' RSA Public Key - modulus N component (clear text).
  OP201_KEY_TYPE_RSA_PUP_E                           = $A0; //!< 'A0' RSA Public Key - public exponent e component (clear text)
  OP201_KEY_TYPE_DES                                 = $80; //!< DES (ECB/CBC) key.
  OP201_KEY_TYPE_DES_ECB                             = $81; //!< DES ECB.
  OP201_KEY_TYPE_DES_CBC                             = $82; //!< DES CBC.

type
  (**
   * The security information negotiated at mutual_authentication().
   *)
  OP201_SECURITY_INFO = record
    securityLevel : Byte;                             //!< The security level.
    sessionMacKey : array [0..15] of Byte;            //!< The MAC session key.
    sessionEncKey : array [0..15] of Byte;            //!< The ENC session key.
    lastMac       : array [0..7] of Byte;             //!< The last computed mac

    // Augusto: added two more attributes for key information

    keySetVersion : Byte;                             //!< The keyset version used in the secure channel
    keyIndex      : Byte;                             //!< The key index used in the secure channel
  end;

  (**
   * The security information negotiated at GP211_mutual_authentication().
   *)
  GP211_SECURITY_INFO = record
    securityLevel             : Byte;                  //!< The security level.
    secureChannelProtocol     : Byte;                  //!< The Secure Channel Protocol.
    secureChannelProtocolImpl : Byte;                  //!< The Secure Channel Protocol implementation.
    C_MACSessionKey           : array [0..31] of Byte; //!< The Secure Channel C-MAC session key.
    R_MACSessionKey           : array [0..31] of Byte; //!< The Secure Channel R-MAC session key.
    encryptionSessionKey      : array [0..31] of Byte; //!< The Secure Channel encryption session key.
    dataEncryptionSessionKey  : array [0..31] of Byte; //!< Secure Channel data encryption key.

   (*
    * Philip Wendland: lastC_MAC must be 16 Bytes for SCP03 because the MAC chaining value
    * for MAC code generation is 16 Bytes (according to GP 2.2 Amendment D), not 8.
    * TODO This probably affects R_MAC too.
    *)

    lastC_MAC                : array [0..15] of Byte;  //!< The last computed C-MAC. Only 8 byte used for SCP01 and SCP02. Used as MAC Chaining Value for SCP03.
    lastR_MAC                : array [0..7] of Byte;   //!< The last computed R-MAC.

    // Augusto: added two more attributes for key information

    keySetVersion            : Byte;                   //!< The keyset version used in secure channel
    keyIndex                 : Byte;                   //!< The key index used in secured channel
    invokingAid              : array [0..15] of Byte;  //!< The invoking AID used for the mutual authentication.
    invokingAidLength        : DWORD;                  //!< The length of the invoking AID buffer.
    sessionEncryptionCounter : LONG;                   //!< Session counter for SCP03 ICV encryption.
    keyLength                : DWORD;                  //!< The key length. 16,24 or 32 bytes.
  end;

  (**
   * A structure describing a Load File Data Block DAP block according to the Open Platform specification 2.0.1'.
   * The structure comprises 3 Tag Length Value (TLV) fields after the ASN.1 specification.
   * The outer tag 0xE2 contains the two inner tags.
   *)
  OP201_DAP_BLOCK = record
    securityDomainAIDLength : Byte;                    //!< The length of the Security Domain.
    securityDomainAID       : array [0..15] of Byte;   //!< The AID of the Security Domain.
    signatureLength         : Byte;                    //!< The length of the signature. Can be 8 for a 3DES signature or 128 for a RSA signature.
    signature               : array [0..127] of Byte;  //!< The signature.
  end;
  OP201_RSA_DAP_BLOCK  = OP201_DAP_BLOCK;
  OP201_3DES_DAP_BLOCK = OP201_DAP_BLOCK;

  (**
   * A structure returned in DELETE, LOAD, INSTALL[for load], INSTALL[for install] with delegated management.
   *)
  OP201_RECEIPT_DATA = record
    receiptLength             : Byte;                  //!< The length of the receipt DAP.
    receipt                   : array [0..7] of Byte;  //!< The receipt DAP.
    confirmationCounterLength : Byte;                  //!< Length of the confirmation counter buffer.
    confirmationCounter       : array [0..1] of Byte;  //!< The confirmation counter buffer.
    cardUniqueDataLength      : Byte;                  //!< The length of the card unique data buffer.
    cardUniqueData            : array [0..9] of Byte;  //!< Card unique data buffer.
  end;

  (**
   * A structure containing key information. Key set version, key index, key type and key length.
   *)
  OP201_KEY_INFORMATION = record
    keySetVersion : Byte;                              //!< The key set version.
    keyIndex      : Byte;                              //!< The key index.
    keyType       : Byte;                              //!< The key type.
    keyLength     : Byte;                              //!< The key length.
  end;

  (**
   * A structure describing a Load File Data Block Signature according to the GlobalPlatform
   * specification 2.1.1.
   *)
  GP211_DAP_BLOCK = record
    securityDomainAIDLength : Byte;                    //!< The length of the Security Domain.
    securityDomainAID       : array [0..15] of Byte;   //!< The AID of the Security Domain.
    signatureLength         : Byte;                    //!< The length of the signature. Can be 8 for a 3DES signature or 128 for a RSA signature.
    signature               : array [0..127] of Byte;  //!< The signature.
  end;
  GP211_RSA_DAP_BLOCK  = GP211_DAP_BLOCK;
  GP211_3DES_DAP_BLOCK = GP211_DAP_BLOCK;
  PGP211_DAP_BLOCK = ^GP211_DAP_BLOCK;


  (**
   * A structure returned in DELETE, LOAD, INSTALL[for load], INSTALL[for install] with delegated management.
   *)
  GP211_RECEIPT_DATA = record
    receiptLength             : Byte;                  //!< The length of the receipt DAP.
    receipt                   : array [0..7] of Byte;  //!< The receipt DAP.
    confirmationCounterLength : Byte;                  //!< Length of the confirmation counter buffer.
    confirmationCounter       : array [0..1] of Byte;  //!< The confirmation counter buffer.
    cardUniqueDataLength      : Byte;                  //!< The length of the card unique data buffer.
    cardUniqueData            : array [0..9] of Byte;  //!< Card unique data buffer.
  end;

  (**
   * A structure containing key information. Key set version, key index, key type and key length.
   *)
  GP211_KEY_INFORMATION = record
    keySetVersion : Byte;                              //!< The key set version.
    keyIndex      : Byte;                              //!< The key index.
    keyType       : Byte;                              //!< The key type.
    keyLength     : USHORT;                            //!< The key length.
    keyUsage      : Byte;                              //!< Key usage used in extended format.
    keyAccess     : Byte;                              //!< Key access used in extended format.
  end;

implementation

end.
