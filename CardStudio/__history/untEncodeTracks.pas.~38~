unit untEncodeTracks;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Imaging.pngimage,
  Vcl.ExtCtrls, Vcl.ComCtrls, Vcl.Menus;

type
  TfrmTracksEncode = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnHelp: TButton;
    btnLoadFromFile: TButton;
    btnEncode: TButton;
    gbTrack: TGroupBox;
    memTrack: TMemo;
    Panel3: TPanel;
    rbTrack1: TRadioButton;
    rbTrack2: TRadioButton;
    gbPAN: TGroupBox;
    edtCardNumber: TEdit;
    pnlCardHolder: TPanel;
    gbFirstName: TGroupBox;
    edtFirstName: TEdit;
    gbLastName: TGroupBox;
    edtLastName: TEdit;
    Panel4: TPanel;
    GroupBox1: TGroupBox;
    GroupBox2: TGroupBox;
    cbExpirationYear: TComboBox;
    cbExpirationMonth: TComboBox;
    Panel5: TPanel;
    GroupBox3: TGroupBox;
    edtPVKI: TEdit;
    GroupBox4: TGroupBox;
    edtPVV: TEdit;
    GroupBox5: TGroupBox;
    edtCVV: TEdit;
    GroupBox6: TGroupBox;
    edtServiceCode: TEdit;
    PopupMenu: TPopupMenu;
    SelectAll1: TMenuItem;
    N2: TMenuItem;
    Copy1: TMenuItem;
    N1: TMenuItem;
    Savetofile1: TMenuItem;
    OpenDialog: TOpenDialog;
    SaveDialog: TSaveDialog;
    N3: TMenuItem;
    N4: TMenuItem;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure rbTrack1Click(Sender: TObject);
    procedure btnEncodeClick(Sender: TObject);
    procedure btnLoadFromFileClick(Sender: TObject);
    procedure Savetofile1Click(Sender: TObject);
    procedure N4Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmTracksEncode: TfrmTracksEncode;

implementation

{$R *.dfm}

uses untMain, untConst, JSON, DateUtils, untMagStripeWrite;

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmTracksEncode.FormCreate(Sender: TObject);
var
  I : Integer;
begin
  // Set width and height
  Width  := 640;
  Height := 450;
  // Populate Expiration Year
  for I := 0 to 10 do
  cbExpirationYear.Items.Add(Format('%.*d', [4, CurrentYear + I]));
  cbExpirationYear.ItemIndex := 0;
  // Populate Expiration Month
  for I := Low(LongMonthNames) to High(LongMonthNames) do
  cbExpirationMonth.Items.Add(LongMonthNames[I]);
  cbExpirationMonth.ItemIndex := 0;
  // Clear Track memo
  memTrack.Clear;
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmTracksEncode.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  Action := caFree;
  Release;
end;

{*******************************************************}
{                    Select Track                       }
{*******************************************************}
procedure TfrmTracksEncode.rbTrack1Click(Sender: TObject);
begin
  // Clear when track is changed
  memTrack.Clear;
  // Show/Hide cardholder first/last name inputs
  case (Sender as TComponent).Tag of
    1 : pnlCardHolder.Visible := True;
    2 : pnlCardHolder.Visible := False;
  end;
end;

{*******************************************************}
{                    Encode Track                       }
{*******************************************************}
procedure TfrmTracksEncode.btnEncodeClick(Sender: TObject);

  function CheckFields(const Track1: Boolean) : Boolean;
  begin
    // Default value
    Result := True;
    // Check PAN
    if Length(edtCardNumber.Text) <= 4 then
    begin
      Application.MessageBox(TrackEmptyFieldPAN, PChar(Application.Title), MB_ICONWARNING + MB_OK);
      Exit(False);
    end;
    // Check Card Holder first name
    if (Length(edtFirstName.Text) = 0) and (not Track1) then
    begin
      Application.MessageBox(TrackEmptyFieldFN, PChar(Application.Title), MB_ICONWARNING + MB_OK);
      Exit(False);
    end;
    // Check Card Holder last name
    if (Length(edtFirstName.Text) = 0) and (not Track1) then
    begin
      Application.MessageBox(TrackEmptyFieldLN, PChar(Application.Title), MB_ICONWARNING + MB_OK);
      Exit(False);
    end;
    // Check Service Code
    if (Length(edtServiceCode.Text) = 0) then
    begin
      Application.MessageBox(TrackEmptyFieldSC, PChar(Application.Title), MB_ICONWARNING + MB_OK);
      Exit(False);
    end;
    // Check PIN Verifcation Key Indicator
    if (Length(edtPVKI.Text) = 0) then
    begin
      Application.MessageBox(TrackEmptyFieldPKI, PChar(Application.Title), MB_ICONWARNING + MB_OK);
      Exit(False);
    end;
    // Check PIN Verification Value
    if (Length(edtPVV.Text) = 0) then
    begin
      Application.MessageBox(TrackEmptyFieldPVV, PChar(Application.Title), MB_ICONWARNING + MB_OK);
      Exit(False);
    end;
    // Check Card Verification Value
    if (Length(edtCVV.Text) = 0) then
    begin
      Application.MessageBox(TrackEmptyFieldCVV, PChar(Application.Title), MB_ICONWARNING + MB_OK);
      Exit(False);
    end;
  end;

  function Track1 : string;
  begin
    // Empty
    Result := '';
    // Clear memo
    memTrack.Clear;
    // Check if all fields are filled
    if CheckFields(True) then
    begin
      Result := Format(TrackEncodeTrack1, [
        edtCardNumber.Text,
        edtFirstName.Text,
        edtLastName.Text,
        Copy(cbExpirationYear.Text, 3, 2),
        2, cbExpirationMonth.ItemIndex +1,
        3, StrToInt(edtServiceCode.Text),
        1, StrToInt(edtPVKI.Text),
        4, StrToInt(edtPVV.Text),
        3, StrToInt(edtCVV.Text)
      ]);
    end;
  end;

  function Track2 : string;
  begin
    // Clear memo
    memTrack.Clear;
    // Check if all fields are filled
    if CheckFields(False) then
    begin
      Result := Format(TrackEncodeTrack2, [
        edtCardNumber.Text,
        Copy(cbExpirationYear.Text, 3, 2),
        2, cbExpirationMonth.ItemIndex +1,
        3, StrToInt(edtServiceCode.Text),
        1, StrToInt(edtPVKI.Text),
        4, StrToInt(edtPVV.Text),
        3, StrToInt(edtCVV.Text)
      ]);
    end;
  end;

begin
  if rbTrack1.Checked then
    memTrack.Text := Track1
  else
    memTrack.Text := Track2;
end;

{*******************************************************}
{               Load Card Data from file                }
{*******************************************************}
procedure TfrmTracksEncode.btnLoadFromFileClick(Sender: TObject);
var
  TRFile : TJSonValue;
  TSFile : TStringList;
begin
  if OpenDialog.Execute(Handle) then
  begin
    TSFile := TStringList.Create;
    try
      TSFile.LoadFromFile(OpenDialog.FileName);
      TRFile := TJSonObject.ParseJSONValue(TSFile.Text);
      try
        edtCardNumber.Text          := (TRFile as TJSONObject).Get('PAN').JSONValue.GetValue<string>;
        edtFirstName.Text           := (TRFile as TJSONObject).Get('FN').JSONValue.GetValue<string>;
        edtLastName.Text            := (TRFile as TJSONObject).Get('LN').JSONValue.GetValue<string>;
        cbExpirationYear.Text       := (TRFile as TJSONObject).Get('EXY').JSONValue.GetValue<string>;
        cbExpirationMonth.ItemIndex := (TRFile as TJSONObject).Get('EXM').JSONValue.GetValue<integer> -1;
        edtServiceCode.Text         := (TRFile as TJSONObject).Get('SC').JSONValue.GetValue<string>;
        edtPVKI.Text                := (TRFile as TJSONObject).Get('PVKI').JSONValue.GetValue<string>;
        edtPVV.Text                 := (TRFile as TJSONObject).Get('PVV').JSONValue.GetValue<string>;
        edtCVV.Text                 := (TRFile as TJSONObject).Get('CVV').JSONValue.GetValue<string>;
      finally
        TRFile.Free;
      end;
    finally
      TSFile.Free;
    end;
  end;
end;

{*******************************************************}
{                 Write tracks to file                  }
{*******************************************************}
procedure TfrmTracksEncode.Savetofile1Click(Sender: TObject);
var
  TRFile : TJSONObject;
  TSFile : TStringList;
begin
  TSFile := TStringList.Create;
  try
    TRFile := TJSONObject.Create();
    try
      // Date
      TRFile.AddPair('dt', DateTimeToUnix(Now).ToString);
      // Track
      if rbTrack1.Checked then
      begin
        TRFile.AddPair('t1', memTrack.Text);
        TRFile.AddPair('t2', '');
        TRFile.AddPair('t3', '');
      end else
      begin
        TRFile.AddPair('t1', '');
        TRFile.AddPair('t2', memTrack.Text);
        TRFile.AddPair('t3', '');
      end;
      // Produce JSON
      TSFile.Text := TRFile.ToJSON;
      // Save to file
      if SaveDialog.Execute(Handle) then
      begin
        TSFile.SaveToFile(SaveDialog.FileName);
      end;
    finally
      TRFile.free;
    end;
  finally
    TSFile.Free;
  end;
end;

{*******************************************************}
{              Write tracks to MagStripe                }
{*******************************************************}
procedure TfrmTracksEncode.N4Click(Sender: TObject);
begin
  frmMain.MagStripeWrite.Execute;
  if Assigned(frmMagStripeWrite) then
  with frmMagStripeWrite do
  begin
    if rbTrack1.Checked then
    begin
      memTrack1.Text := memTrack.Text;
      memTrack2.Clear;
      memTrack3.Clear;
    end else
    begin
      memTrack1.Clear;
      memTrack2.Text := memTrack.Text;
      memTrack3.Clear;
    end;
  end;
end;

end.
