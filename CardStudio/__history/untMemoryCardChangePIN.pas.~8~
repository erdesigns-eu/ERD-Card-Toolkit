unit untMemoryCardChangePIN;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Imaging.pngimage,
  Vcl.ExtCtrls, untPCSC, untUSB, Registry;

type
  TfrmMemoryCardChangePIN = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnHelp: TButton;
    btnChange: TButton;
    gbCurrrent: TGroupBox;
    edtCurrent: TEdit;
    gbNew: TGroupBox;
    edtNew: TEdit;
    gbReader: TGroupBox;
    cbReader: TComboBox;
    gbResponse: TGroupBox;
    memResponse: TMemo;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnChangeClick(Sender: TObject);
  private
    { Private declarations }
    PCSC         : TPCSC;
    FUSBNotifier : TComponentUSB;
    FSelectCard  : Boolean;

    procedure USBArrivalRemoval(Sender: TObject);
  public
    { Public declarations }
  end;

var
  frmMemoryCardChangePIN: TfrmMemoryCardChangePIN;

implementation

{$R *.dfm}

uses untConst, untEMVTools, untAPDUParser, Math;

{*******************************************************}
{               USB Insert/Remove Event                 }
{*******************************************************}
procedure TfrmMemoryCardChangePIN.USBArrivalRemoval(Sender: TObject);
begin
  // Reload SmartCard Reader/Writers
  PCSC.Init;
  // Populate list
  cbReader.Items.Assign(PCSC.ReaderList);
  if cbReader.Items.Count > 0 then
  begin
    PCSC.UseReaderNum := 0;
    cbReader.ItemIndex := 0;
  end;
  // Disconnect PCSC
  PCSC.Disconnect;
  PCSC.Close;
end;

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmMemoryCardChangePIN.FormCreate(Sender: TObject);
var
  R : TRegistry;
begin
  // Set width and height
  Width  := 640;
  Height := 480;
  // Create PCSC
  PCSC := TPCSC.Create;
  PCSC.Init;
  // Populate SmartCard readers/writers
  cbReader.Items.Assign(PCSC.ReaderList);
  if cbReader.Items.Count > 0 then
  begin
    R := TRegistry.Create;
    try
      R.RootKey := HKEY_CURRENT_USER;
      if R.OpenKey(ApplicationRegKey, True) and R.ValueExists(MCDefault) and R.ValueExists(MCSLE4442Select) and R.ValueExists(MCSLE4442PIN) then
      begin
        cbReader.ItemIndex := cbReader.Items.IndexOf(R.ReadString(MCDefault));
        PCSC.UseReaderNum := cbReader.ItemIndex;
        FSelectCard := R.ReadBool(MCSLE4442Select);
        edtCurrent.Text := R.ReadString(MCSLE4442PIN);
      end else
      begin
        PCSC.UseReaderNum := 0;
        cbReader.ItemIndex := 0;
        FSelectCard := False;
        edtCurrent.Text := '';
      end;
    finally
      R.Free;
    end;
  end;
  // Disconnect PCSC
  PCSC.Disconnect;
  PCSC.Close;
  // Create USB insert/remove notifier component
  FUSBNotifier := TComponentUSB.Create(Self);
  FUSBNotifier.OnUSBArrival := USBArrivalRemoval;
  FUSBNotifier.OnUSBRemove  := USBArrivalRemoval;
  // Clear response memo
  memResponse.Clear;
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmMemoryCardChangePIN.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  // Free USB insert/remove notifier component
  FUSBNotifier.Destroy;
  // Free PCSC
  PCSC.Free;
  // Free Form
  Action := caFree;
  Release;
end;

{*******************************************************}
{             Change Memory Card PIN Code               }
{*******************************************************}
procedure TfrmMemoryCardChangePIN.btnChangeClick(Sender: TObject);

  function FormatData(const D: string) : string;
  var
    I, X : Integer;
  begin
    Result := '';
    X := 1;
    for I := 1 to Ceil(Length(D) / 2) do
    begin
      Result := Result + Copy(D, X, 2) + ' ';
      Inc(X, 2);
    end;
    Result := Trim(Result);
  end;

  function SelectCard : Boolean;
  begin
    Result := Bin2HexExt(PCSC.GetResponseFromCard(Hex2Bin('FF A4 00 00 01 06'))) = '90 00';
  end;

  function WritePinCode(const PINCode: AnsiString) : Boolean;
  begin
    Result := Bin2HexExt(PCSC.GetResponseFromCard(Hex2Bin(
      Format('FF 20 00 00 %.*x %s', [2, Length(PINCode) div 2, FormatData(PINCode)])
      //
    ))) = '90 00';
  end;

  {function ChangePin(const Current: AnsiString; const New: AnsiString) : string;
  var
    S : AnsiString;
  begin
    S := StringReplace(Current, ' ', '', [rfReplaceAll]) + StringReplace(New, ' ', '', [rfReplaceAll]);
    Result := Bin2HexExt(PCSC.GetResponseFromCard(Hex2Bin(
      Format('FF 21 00 00 %.*x 00 %s', [2, Length(S) div 2, FormatData(S)])
    )));
  end;}
  function ChangePin(const New: AnsiString) : string;
  var
    S : AnsiString;
  begin
    S := StringReplace(New, ' ', '', [rfReplaceAll]);
    Result := Bin2HexExt(PCSC.GetResponseFromCard(Hex2Bin(
      Format('FF 21 00 00 %.*x %s', [2, Length(S) div 2, FormatData(S)])
      //Format('FF 21 00 00 %.*x 00 %s', [2, Length(S) div 2, FormatData(S)])
    )));
  end;

var
  P : TAPDUParser;
  I : Integer;
  B : Boolean;
  S : string;
begin
  B := True;
  if not TryStrToInt('$' + edtCurrent.Text, I) then
  begin
    B := False;
    Application.MessageBox('Current PIN Code needs to be valid HEX format!', ApplicationTitle, MB_ICONWARNING or MB_OK);
  end;
  if not TryStrToInt('$' + edtNew.Text, I) then
  begin
    B := False;
    Application.MessageBox('New PIN Code needs to be valid HEX format!', ApplicationTitle, MB_ICONWARNING or MB_OK);
  end;
  if (cbReader.ItemIndex = -1) or (not B) then Exit;
  // Initialize Card Reader/Writer
  PCSC.Init;
  PCSC.UseReaderNum := cbReader.ItemIndex;
  if PCSC.Open and PCSC.Connect then
  with memResponse.Lines do
  begin
    BeginUpdate;
    // Clear
    Clear;
    // Header
    Add(MCPINHeader);
    //
    if FSelectCard then
    begin
      if SelectCard then
      begin
        if WritePinCode(edtCurrent.Text) then
        begin
          P := TAPDUParser.Create('', ChangePin(edtNew.Text));
          try
            // SW 1
            Add(Format(MCPINRespSW1, [2, P.Response.SW1]));
            // SW 2
            Add(Format(MCPINRespSW2, [2, P.Response.SW2]));
            // Response code description
            Add(Format(MCPINRespStatus, [P.ResponseStatus.Description]));
          finally
            P.Free;
          end;
        end else
          Add('Invalid PIN Code!');
      end;
    end else
    begin
      if WritePinCode(edtCurrent.Text) then
      begin
        P := TAPDUParser.Create('', ChangePin(edtNew.Text));
        try
          // SW 1
          Add(Format(MCPINRespSW1, [2, P.Response.SW1]));
          // SW 2
          Add(Format(MCPINRespSW2, [2, P.Response.SW2]));
          // Response code description
          Add(Format(MCPINRespStatus, [P.ResponseStatus.Description]));
        finally
          P.Free;
        end;
      end else
        Add('Invalid PIN Code!');
    end;
    EndUpdate;
  end;
  PCSC.Disconnect;
  PCSC.Close;
end;

end.
