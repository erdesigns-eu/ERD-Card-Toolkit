unit untDatabaseEdit;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls,
  Vcl.ComCtrls, Vcl.Imaging.pngimage;

type
  TfrmDatabaseEdit = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnCancel: TButton;
    btnOK: TButton;
    PC: TPageControl;
    TabSheet1: TTabSheet;
    panel4: TPanel;
    gbIssuer: TGroupBox;
    edtIssuer: TEdit;
    gbIssuerURL: TGroupBox;
    edtIssuerURL: TEdit;
    Panel5: TPanel;
    gbCountry: TGroupBox;
    cbCountry: TComboBox;
    gbCurrency: TGroupBox;
    cbCurrency: TComboBox;
    pnlCardHolder: TPanel;
    gbFirstName: TGroupBox;
    edtFirstName: TEdit;
    gbLastName: TGroupBox;
    edtLastName: TEdit;
    Panel6: TPanel;
    GroupBox1: TGroupBox;
    cbExpirationYear: TComboBox;
    GroupBox2: TGroupBox;
    cbExpirationMonth: TComboBox;
    gbCVV: TGroupBox;
    edtCVV: TEdit;
    gbPIN: TGroupBox;
    edtPIN: TEdit;
    Panel7: TPanel;
    gbScheme: TGroupBox;
    cbScheme: TComboBox;
    gbType: TGroupBox;
    cbType: TComboBox;
    gbCategory: TGroupBox;
    edtCategory: TEdit;
    Panel3: TPanel;
    gbPAN: TGroupBox;
    edtPAN: TEdit;
    TabSheet2: TTabSheet;
    GridPanel1: TGridPanel;
    gbTrack1: TGroupBox;
    memTrack1: TMemo;
    gbTrack2: TGroupBox;
    memTrack2: TMemo;
    gbTrack3: TGroupBox;
    memTrack3: TMemo;
    TabSheet3: TTabSheet;
    memComment: TMemo;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnCancelClick(Sender: TObject);
    procedure btnOKClick(Sender: TObject);
  private
    { Private declarations }
    FDatabaseFile : string;
    FRowID        : Integer;
  public
    { Public declarations }
    property DatabaseFile: string read FDatabaseFile write FDatabaseFile;
    property RowID: Integer read FRowID write FRowID;

    procedure LoadCard(const R: Integer);
  end;

var
  frmDatabaseEdit: TfrmDatabaseEdit;

implementation

{$R *.dfm}

uses untConst, untBIN, SQLite3, SQLite3Wrap, Registry, untDatabase,
     System.RegularExpressions;

{*******************************************************}
{                   Load Card Data                      }
{*******************************************************}
procedure TfrmDatabaseEdit.LoadCard(const R: Integer);
var
  DB : TSQLite3Database;
  ST : TSQLite3Statement;
begin
  if FileExists(DatabaseFile) then
  begin
    DB := TSQLite3Database.Create;
    try
      RowID := R;
      DB.Open(FDatabaseFile);
      ST := DB.Prepare(Format(DBSelectCard, [R]));
      try
        while ST.Step = SQLITE_ROW do
        begin
          edtPAN.Text := ST.ColumnText(1);
          cbScheme.ItemIndex          := cbScheme.Items.IndexOfObject(TObject(ST.ColumnInt(2)));
          cbType.ItemIndex            := cbScheme.Items.IndexOfObject(TObject(ST.ColumnInt(3)));
          edtCategory.Text            := ST.ColumnText(4);
          edtIssuer.Text              := ST.ColumnText(5);
          edtIssuerURL.Text           := ST.ColumnText(6);
          cbCountry.ItemIndex         := cbCountry.Items.IndexOfObject(TObject(ST.ColumnInt(7)));
          cbCurrency.ItemIndex        := cbCurrency.Items.IndexOfObject(TObject(ST.ColumnInt(8)));
          edtFirstName.Text           := ST.ColumnText(9);
          edtLastName.Text            := ST.ColumnText(10);
          cbExpirationYear.ItemIndex  := cbExpirationYear.Items.IndexOfObject(TObject(ST.ColumnInt(11)));
          cbExpirationMonth.ItemIndex := cbExpirationMonth.Items.IndexOfObject(TObject(ST.ColumnInt(12)));
          {memTrack1.Text              := ST.ColumnText(13);
          memTrack2.Text              := ST.ColumnText(14);
          memTrack3.Text              := ST.ColumnText(15);
          edtCVV.Text                 := ST.ColumnText(16);
          edtPIN.Text                 := ST.ColumnText(17);
          memComment.Text             := ST.ColumnText(18);}
        end;
      finally
        ST.Free;
      end;
    finally
      DB.Free;
    end;
  end;
end;

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmDatabaseEdit.FormCreate(Sender: TObject);
var
  R : TRegistry;
  I : Integer;
begin
  R := TRegistry.Create;
  try
    R.RootKey := HKEY_CURRENT_USER;
    if R.OpenKey(ApplicationRegKey, True) then
    begin
      // Database File
      if R.ValueExists(DBFile) then DatabaseFile := R.ReadString(DBFile)
    end;
  finally
    R.Free;
  end;
  // Set width and height
  Width  := 640;
  Height := 530;
  // Set page 1
  PC.ActivePageIndex := 0;
  // Clear memo's
  memTrack1.Clear;
  memTrack2.Clear;
  memTrack3.Clear;
  memComment.Clear;
  // Card Schemes
  for I := Low(CardSchemes) to High(CardSchemes) do
  cbScheme.Items.AddObject(CardSchemeToStr(CardSchemes[I]), TObject(CardSchemes[I]));
  cbScheme.ItemIndex := 0;
  // Card Types
  for I := Low(CardTypes) to High(CardTypes) do
  cbType.Items.AddObject(CardTypeToStr(CardTypes[I]), TObject(CardTypes[I]));
  cbType.ItemIndex := 0;
  // Countries
  for I := Low(CountryCodes) to High(CountryCodes) do
  cbCountry.Items.AddObject(CountryCodeToStr(CountryCodes[I]), TObject(CountryCodes[I]));
  cbCountry.ItemIndex := 0;
  // Currency Codes
  for I := Low(CurrencyCodes) to High(CurrencyCodes) do
  cbCurrency.Items.AddObject(CurrencyCodeToStr(CurrencyCodes[I]), TObject(CurrencyCodes[I]));
  cbCurrency.ItemIndex := 0;
  // Years
  for I := 0 to 10 do
  cbExpirationYear.Items.Add(Format('%.*d', [4, CurrentYear + I]));
  cbExpirationYear.ItemIndex := 0;
  // Months
  for I := Low(LongMonthNames) to High(LongMonthNames) do
  cbExpirationMonth.Items.Add(LongMonthNames[I]);
  cbExpirationMonth.ItemIndex := 0;
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmDatabaseEdit.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Action := caFree;
  Release;
end;

{*******************************************************}
{                   Save to Database                    }
{*******************************************************}
procedure TfrmDatabaseEdit.btnOKClick(Sender: TObject);
var
  DB : TSQLite3Database;
  ST : TSQLite3Statement;
begin
  DB := TSQLite3Database.Create;
  try
    DB.Open(DatabaseFile);
    ST := DB.Prepare(Format(DBUpdateCard, [RowID]));
    ST.BindText(1, edtPAN.Text);
    ST.BindInt(2, TCardScheme(cbScheme.Items.Objects[cbScheme.ItemIndex]));
    ST.BindInt(3, TCardType(cbType.Items.Objects[cbType.ItemIndex]));
    ST.BindText(4, edtCategory.Text);
    ST.BindText(5, edtIssuer.Text);
    ST.BindText(6, edtIssuerURL.Text);
    ST.BindInt(7, TCountryCode(cbCountry.Items.Objects[cbCountry.ItemIndex]));
    ST.BindInt(8, TCurrencyCode(cbCurrency.Items.Objects[cbCurrency.ItemIndex]));
    ST.BindText(9, edtFirstName.Text);
    ST.BindText(10, edtLastName.Text);
    ST.BindInt(11, StrToInt(cbExpirationYear.Text));
    ST.BindInt(12, cbExpirationMonth.ItemIndex +1);
    ST.BindText(13, memTrack1.Text);
    ST.BindText(14, memTrack2.Text);
    ST.BindText(15, memTrack3.Text);
    ST.BindText(16, edtCVV.Text);
    ST.BindText(17, edtPIN.Text);
    ST.BindText(18, memComment.Text);
    // Update table
    ST.StepAndReset;
    // Update list with CCS in browser
    if Assigned(frmDatabase) then frmDatabase.ExecuteQuery(DBSelectCards);
  finally
    DB.Free;
  end;
  // Close window
  Close;
end;

{*******************************************************}
{                       Cancel                          }
{*******************************************************}
procedure TfrmDatabaseEdit.btnCancelClick(Sender: TObject);
begin
  Close;
end;

end.
