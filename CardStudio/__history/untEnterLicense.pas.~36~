unit untEnterLicense;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Imaging.pngimage,
  Vcl.ExtCtrls;

type
  TfrmEnterLicense = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnCancel: TButton;
    btnOK: TButton;
    GroupBox1: TGroupBox;
    edtLicense1: TEdit;
    Label3: TLabel;
    Label4: TLabel;
    edtLicense2: TEdit;
    edtLicense3: TEdit;
    Label5: TLabel;
    edtLicense4: TEdit;
    Label6: TLabel;
    edtLicense5: TEdit;
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
    OrigLicenseEdit1 : TWndMethod;
    OrigLicenseEdit2 : TWndMethod;
    OrigLicenseEdit3 : TWndMethod;
    OrigLicenseEdit4 : TWndMethod;
    OrigLicenseEdit5 : TWndMethod;

    procedure LicenseEdit1WindowProc(var Message: TMessage);
    procedure LicenseEdit2WindowProc(var Message: TMessage);
    procedure LicenseEdit3WindowProc(var Message: TMessage);
    procedure LicenseEdit4WindowProc(var Message: TMessage);
    procedure LicenseEdit5WindowProc(var Message: TMessage);

    function HandlePaste : Boolean;
  public
    { Public declarations }
    function Execute : TModalResult;
    function LicenseKey : string;
  end;

var
  frmEnterLicense: TfrmEnterLicense;

implementation

{$R *.dfm}

uses untConst, ClipBrd, System.RegularExpressions;

{*******************************************************}
{           Handle PASTE in License Key Edit            }
{*******************************************************}
function TfrmEnterLicense.HandlePaste : Boolean;

  function IsValidLicenseKeyFormat(const LK: string) : Boolean;
  begin
    Result := TRegEx.IsMatch(LK, LicenseKeyRegEx);
  end;

var
  LK : string;
  SL : TStringList;
begin
  Result := False;
  LK := Clipboard.AsText;

  if IsValidLicenseKeyFormat(LK) then Caption := 'YES' else Caption := 'NO';

  if IsValidLicenseKeyFormat(LK) then
  begin
    SL := TStringList.Create;
    try
      SL.Delimiter := '-';
      SL.StrictDelimiter := True;
      SL.DelimitedText := LK;
      // Check length
      if SL.Count = 5 then
      begin
        // Part 1
        edtLicense1.Text := SL[0];
        // Part 2
        edtLicense2.Text := SL[1];
        // Part 3
        edtLicense3.Text := SL[2];
        // Part 4
        edtLicense4.Text := SL[3];
        // Part 5
        edtLicense5.Text := SL[4];
        //
        Result := True;
      end;
    finally
      SL.Free;
    end;
  end;
end;

{*******************************************************}
{                     Catch Paste                       }
{*******************************************************}
procedure TfrmEnterLicense.LicenseEdit1WindowProc(var Message: TMessage);
begin
  if (Message.Msg <> WM_PASTE) or ((Message.Msg = WM_PASTE) and (not HandlePaste)) then OrigLicenseEdit1(Message);
end;

{*******************************************************}
{                     Catch Paste                       }
{*******************************************************}
procedure TfrmEnterLicense.LicenseEdit2WindowProc(var Message: TMessage);
begin
  if (Message.Msg <> WM_PASTE) or ((Message.Msg = WM_PASTE) and (not HandlePaste)) then OrigLicenseEdit2(Message)
end;

{*******************************************************}
{                     Catch Paste                       }
{*******************************************************}
procedure TfrmEnterLicense.LicenseEdit3WindowProc(var Message: TMessage);
begin
  if (Message.Msg <> WM_PASTE) or ((Message.Msg = WM_PASTE) and (not HandlePaste)) then OrigLicenseEdit3(Message)
end;

{*******************************************************}
{                     Catch Paste                       }
{*******************************************************}
procedure TfrmEnterLicense.LicenseEdit4WindowProc(var Message: TMessage);
begin
  if (Message.Msg <> WM_PASTE) or ((Message.Msg = WM_PASTE) and (not HandlePaste)) then OrigLicenseEdit4(Message)
end;

{*******************************************************}
{                     Catch Paste                       }
{*******************************************************}
procedure TfrmEnterLicense.LicenseEdit5WindowProc(var Message: TMessage);
begin
  if (Message.Msg <> WM_PASTE) or ((Message.Msg = WM_PASTE) and (not HandlePaste)) then OrigLicenseEdit5(Message)
end;

{*******************************************************}
{                    Execute Modal                      }
{*******************************************************}
function TfrmEnterLicense.Execute: TModalResult;
begin
  // Clear Edit's
  edtLicense1.Text := '';
  edtLicense2.Text := '';
  edtLicense3.Text := '';
  edtLicense4.Text := '';
  edtLicense5.Text := '';
  // Show Dialog
  Result := ShowModal;
end;

{*******************************************************}
{                   Get License Key                     }
{*******************************************************}
function TfrmEnterLicense.LicenseKey: string;
begin
  Result := Format('%s-%s-%s-%s-%s', [
    edtLicense1.Text,
    edtLicense2.Text,
    edtLicense3.Text,
    edtLicense4.Text,
    edtLicense5.Text
  ]);
end;

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmEnterLicense.FormCreate(Sender: TObject);
begin
  // Set width and height
  Width  := 472;
  Height := 210;
  // Set original - so we can redirect all other msg
  OrigLicenseEdit1 := edtLicense1.WindowProc;
  OrigLicenseEdit2 := edtLicense2.WindowProc;
  OrigLicenseEdit3 := edtLicense3.WindowProc;
  OrigLicenseEdit4 := edtLicense4.WindowProc;
  OrigLicenseEdit5 := edtLicense5.WindowProc;
  // Set alternative - catch paste
  edtLicense1.WindowProc := LicenseEdit1WindowProc;
  edtLicense2.WindowProc := LicenseEdit2WindowProc;
  edtLicense3.WindowProc := LicenseEdit3WindowProc;
  edtLicense4.WindowProc := LicenseEdit4WindowProc;
  edtLicense5.WindowProc := LicenseEdit5WindowProc;
end;

end.
