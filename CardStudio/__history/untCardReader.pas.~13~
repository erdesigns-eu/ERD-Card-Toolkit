type
  // Reference
  TASNItem = class;

  {*******************************************************}
  {                     ASN Item List                     }
  {*******************************************************}
  TASNItemList = class(TObjectList<TASNItem>);

  {*******************************************************}
  {                   ASN Universal Tag                   }
  {*******************************************************}
  TAsnUniversalTags = (
    asnEoc             = $00, //0: End-of-contents octets
    asnBoolean         = $01, //1: Boolean
    asnInteger         = $02, //2: Integer
    asnBitString       = $03, //3: Bit string
    asnOctetString     = $04, //4: Byte string
    asnNullTag         = $05, //5: Null
    asnOid             = $06, //6: Object Identifier
    asnObjDescriptor   = $07, //7: Object Descriptor
    asnExternal        = $08, //8: External
    asnReal            = $09, //9: Real
    asnEnumerated      = $0A, //10: Enumerated
    asnEmbedded_Pdv    = $0B, //11: Embedded Presentation Data Value
    asnUtf8String      = $0C, //12: UTF8 string
    asnSequence        = $10, //16: Sequence/sequence of
    asnSet             = $11, //17: Set/set of
    asnNumericString   = $12, //18: Numeric string
    asnPrintableString = $13, //19: Printable string (ASCII subset)
    asnT61String       = $14, //20: T61/Teletex string
    asnVideotexString  = $15, //21: Videotex string
    asnIA5String       = $16, //22: IA5/ASCII string
    asnUtcTime         = $17, //23: UTC time
    asnGeneralizedTime = $18, //24: Generalized time
    asnGraphicString   = $19, //25: Graphic string
    asnVisibleString   = $1A, //26: Visible string (ASCII subset)
    asnGeneralString   = $1B, //27: General string
    asnUniversalString = $1C, //28: Universal string
    asnBmpString       = $1E  //30: Basic Multilingual Plane/Unicode string
  );

  TAsnTagConstructed = (
    asnPrimitive       = 0,
    asnConstructed     = 1
  );

  {*******************************************************}
  {                       ASN Item                        }
  {*******************************************************}
  TASNItem = class
  private
    FChildren : TASNItemList;
    FType     : TAsnUniversalTags;
    FTag      : string;
    FValue    : RawByteString;
    FLength   : Byte;
    FHLength  : Byte;
    FFlag     : TAsnTagConstructed;
  public
    constructor Create(Tag: string; Value: RawByteString; Length: Byte); overload; virtual;
    constructor Create; overload; virtual;
    destructor Destroy; override;

    property Children: TASNItemList read FChildren;
    property &Type: TAsnUniversalTags read FType;
    property Tag: string read FTag;
    property Value: RawByteString read FValue;
    property Length: Byte read FLength;
    property HeaderLength: Byte read FHLength;
    property Flag: TAsnTagConstructed read FFlag;
  end;

  {*******************************************************}
  {                      ASN Parser                       }
  {*******************************************************}
  TASNParser = class
  private
    FItems : TASNItemList;

    function ParseItem(const Data: RawByteString; var Index: Integer; var Item: TAsnItem): Boolean;
    function TryParseItem(const Data: RawByteString; var Item: TAsnItem): Boolean;
    procedure ParseAsnItem(Parent: TASNItemList; const Data: RawByteString);
    function FindEMVTag(const Tag: RawByteString) : Integer;
  public
    constructor Create; virtual;
    destructor Destroy; override;

    procedure Parse(const Data: RawByteString);

    property Itemss: TASNItemList read FItems;
  end;

implementation

const
  TagNumberMask          = $1F; //Bits 5 - 1
  TagConstructedFlagMask = $20; //Bit 6
  TagClassMask           = $C0; //Bits 7 - 8
  Bit8Mask               = $80; //Indefinite or long form
  Bits7Mask              = $7F; //Bits 7 - 1

{*******************************************************}
{                       ASN Item                        }
{*******************************************************}
constructor TASNItem.Create(Tag: string; Value: RawByteString; Length: Byte);
begin
  inherited Create;

  // Create child list
  FChildren := TASNItemList.Create(True);

  // Set Tag
  FTag := Tag;
  // Set Value
  FValue := Value;
  // Set Length
  FLength := Length;
end;

constructor TASNItem.Create;
begin
  inherited Create;

  // Create Child list
  FChildren := TASNItemList.Create(True);
end;

destructor TASNItem.Destroy;
begin
  // Free Child list
  FChildren.Free;

  inherited Destroy;
end;

{*******************************************************}
{                      ASN Parser                       }
{*******************************************************}
constructor TASNParser.Create;
begin
  inherited Create;

  // Create Items list
  FItems := TASNItemList.Create(True);
end;

destructor TASNParser.Destroy;
begin
  // Free Items list
  FItems.Free;

  inherited Destroy;
end;

function TASNParser.ParseItem(const Data: RawByteString; var Index: Integer; var Item: TAsnItem) : Boolean;
var
  B1, B2 : Integer;
  LL, LC : Cardinal;
  TI     : Integer;
begin
  //
  Result := True;

  //
  LL := 0;

  // Tag info
  B1 := Byte(Data[Index]);
  Inc(Index);

  // Tag Type
  Item.FType := TAsnUniversalTags(B1 and TagNumberMask);
  // Constructed Flag
  Item.FFlag := TAsnTagConstructed((B1 and TagConstructedFlagMask) shr 5);

  // Tag length
  Item.FLength := Byte(Data[Index]);
  Inc(Index);

  //
  if (Item.FLength and Bit8Mask) <> 0 then
  begin
    //We have a multiple byte length
    LL := Item.FLength and Bits7Mask;

    if LL = 0 then
    begin
      Result := False;
    end;

    if LL > 4 then
    begin
      Result := False;
    end;

    Item.FLength := 0;
    for LC := 0 to LL - 1 do
    begin
      B2 := Byte(Data[Index]);
      Inc(Index);
      Item.FLength := (Item.FLength shl 8) or B2;
    end;
  end;
  // Header length
  Item.FHLength := LL + 2;
  // Tag value
  Item.FValue  := Copy(Data, Index, Item.FLength);
  // Tag Name
  TI := FindEMVTag(Copy(Item.FValue, 0, Item.FHLength));
  if (TI > -1) then Item.FTag := EMVTagList[TI].Name;

  //
  Inc(Index, Item.FLength);
end;

function TASNParser.TryParseItem(const Data: RawByteString; var Item: TAsnItem) : Boolean;
var
  Dummy: Integer;
begin
  Dummy := 1;
  try
    Result := ParseItem(Data, Dummy, Item);
  except
    Result := False;
  end;
end;

procedure TASNParser.ParseAsnItem(Parent: TASNItemList; const Data: RawByteString);
var
  Item  : TASNItem;
  Probe : TASNItem;
  Value : string;
  Index : Integer;
begin
  //
  Index := 1;
  Item := TASNItem.Create;
  ParseItem(Data, Index, Item);

  //
  if Item.FFlag = asnConstructed then
  begin
    ParseAsnItem(Item.FChildren, Item.FValue);
  end else
  begin

    case Item.FType of
      asnEoc: ;
      asnBoolean: ;
      asnInteger: ;
      asnBitString: ;
      asnOctetString: ;
      asnNullTag: ;
      asnOid: ;
      asnObjDescriptor: ;
      asnExternal: ;
      asnReal: ;
      asnEnumerated: ;
      asnEmbedded_Pdv: ;
      asnUtf8String: ;
      asnSequence: ;
      asnSet: ;
      asnNumericString: ;
      asnPrintableString: ;
      asnT61String: ;
      asnVideotexString: ;
      asnIA5String: ;
      asnUtcTime: ;
      asnGeneralizedTime: ;
      asnGraphicString: ;
      asnVisibleString: ;
      asnGeneralString: ;
      asnUniversalString: ;
      asnBmpString: ;
    end;

  end;

  // Add item to parent list
  Parent.Add(Item);
end;

function TASNParser.FindEMVTag(const Tag: RawByteString) : Integer;
var
  I : Integer;
begin
  Result := -1;
  for I := Low(EMVTagList) to High(EMVTagList) do
  if EMVTagList[I].Tag = Uppercase(Tag) then
  begin
    Result := I;
    Break;
  end;
end;

procedure TASNParser.Parse(const Data: RawByteString);
begin
  ParseAsnItem(FItems, Data);
end;

end.
