unit untSmartCardRead;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Imaging.pngimage, Registry,
  Vcl.ExtCtrls, Vcl.ComCtrls, System.ImageList, Vcl.ImgList, untPCSC, untEMV, untUSB;

type
  TfrmSmartCardRead = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnHelp: TButton;
    btnRead: TButton;
    btnSave: TButton;
    gbReader: TGroupBox;
    cbReader: TComboBox;
    gbCardData: TGroupBox;
    tvCard: TTreeView;
    gbInformation: TGroupBox;
    Images: TImageList;
    memLog: TMemo;
    Splitter: TSplitter;
    SaveDialog: TSaveDialog;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnReadClick(Sender: TObject);
    procedure btnSaveClick(Sender: TObject);
  private
    { Private declarations }
    PCSC         : TPCSC;
    EMV          : TEMVCard;
    FUSBNotifier : TComponentUSB;

    procedure USBArrivalRemoval(Sender: TObject);
  public
    { Public declarations }
  end;

var
  frmSmartCardRead: TfrmSmartCardRead;

implementation

{$R *.dfm}

uses untConst, untAPDUParser, untASNParser, untEMVTools, untBIN, System.Math;

{*******************************************************}
{               USB Insert/Remove Event                 }
{*******************************************************}
procedure TfrmSmartCardRead.USBArrivalRemoval(Sender: TObject);
begin
  // Reload SmartCard Reader/Writers
  PCSC.Init;
  // Populate list
  cbReader.Items.Assign(PCSC.ReaderList);
  if cbReader.Items.Count > 0 then
  begin
    PCSC.UseReaderNum := 0;
    cbReader.ItemIndex := 0;
  end;
  // Disconnect PCSC
  PCSC.Disconnect;
  PCSC.Close;
end;

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmSmartCardRead.FormCreate(Sender: TObject);
var
  R : TRegistry;
begin
  // Set width and height
  Width  := 800;
  Height := 640;
  // Create PCSC
  PCSC := TPCSC.Create;
  PCSC.Init;
  // Populate SmartCard readers/writers
  cbReader.Items.Assign(PCSC.ReaderList);
  if cbReader.Items.Count > 0 then
  begin
    R := TRegistry.Create;
    try
      R.RootKey := HKEY_CURRENT_USER;
      if R.OpenKey(ApplicationRegKey, True) and R.ValueExists(PCSCDefault) then
      begin
        cbReader.ItemIndex := cbReader.Items.IndexOf(R.ReadString(PCSCDefault));
        PCSC.UseReaderNum := cbReader.ItemIndex;
      end else
      begin
        PCSC.UseReaderNum := 0;
        cbReader.ItemIndex := 0;
      end;
    finally
      R.Free;
    end;
  end;
  // Disconnect PCSC
  PCSC.Disconnect;
  PCSC.Close;
  // Create USB insert/remove notifier component
  FUSBNotifier := TComponentUSB.Create(Self);
  FUSBNotifier.OnUSBArrival := USBArrivalRemoval;
  FUSBNotifier.OnUSBRemove  := USBArrivalRemoval;
  // Create EMV
  EMV := TEMVCard.Create(PCSC);
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmSmartCardRead.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  // Free USB insert/remove notifier component
  FUSBNotifier.Destroy;
  // Free EMV
  EMV.Free;
  // Free PCSC
  PCSC.Free;
  // Free Form
  Action := caFree;
  Release;
end;

{*******************************************************}
{                  Read SmartCard Data                  }
{*******************************************************}
procedure TfrmSmartCardRead.btnReadClick(Sender: TObject);
begin
  if (cbReader.ItemIndex = -1) then Exit;
  PCSC.Init;
  PCSC.UseReaderNum := cbReader.ItemIndex;
  if PCSC.Open and PCSC.Connect then
  begin
    EMV.ReadCard;
    with tvCard.Items do
    begin
      BeginUpdate;
      Clear;
      EMV.LoadTree(tvCard);

      memLog.Text := TASNParser.Encode(EMV.Applications.Items[1].AnswerToSelect);

      //memLog.Lines.Assign(EMV.Log);
      btnSave.Enabled := EMV.Applications.Count > 0;
      EndUpdate;
    end;
  end;
  PCSC.Disconnect;
  PCSC.Close;
end;

{*******************************************************}
{                  Read SmartCard Data                  }
{*******************************************************}
procedure TfrmSmartCardRead.btnSaveClick(Sender: TObject);
begin
  if SaveDialog.Execute(Handle) and (SaveDialog.FileName <> '') then
  EMV.SaveToFile(SaveDialog.FileName);
end;

end.
