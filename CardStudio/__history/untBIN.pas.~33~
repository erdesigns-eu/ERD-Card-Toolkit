function LuhnAlgorithmCheckDigit(const N: string ) : Integer;
var
  I, S : Integer;
  T    : string;
begin
  S := 0;
  for I := Length(N) downto 1 do
  begin
    if Odd(I){(I mod 2 = 0)} then
      T := T + IntToStr(StrToInt(N[I]) * 2)
    else
      T := T + IntToStr(StrToInt(N[I]));
  end;
  for I := 1 to Length(T) do Inc(S, StrToInt(T[I]));
  Result := ((10 - S mod 10) mod 10);
  //if I = 10 then Result := 0 else Result := I;
end;

{*******************************************************}
{        Check if card number passes LUHN check         }
{*******************************************************}
function IsLuhnValid(const N: string ) : Boolean;
var
  I, L : Integer;
begin
  L := length(N);
  I := LuhnAlgorithmCheckDigit(Copy(N, 1, L -1));
  Result := I = StrToInt(N[L]);
end;

{*******************************************************}
{            Find BIN in array of TBINRec               }
{*******************************************************}
function FindBIN(const BINS: array of TBINRec; const BIN: string) : Integer;
var
  I, B : Integer;
begin
  Result := -1;
  if TryStrToInt(Copy(BIN, 1, 6), B) then
  begin
    for I := Low(BINS) to High(BINS) do
    if (BINS[I].iin_start >= B) and (BINS[I].iin_end <= B) then
    begin
      Result := I;
      Break;
    end;
  end;
end;

{*******************************************************}
{                   Find Card Scheme                    }
{*******************************************************}
function FindCardScheme(const N: string) : TCardScheme;
begin
  // AMEX
  if Is_AMEX(N) then
    Result := csAMEX
  else
  // MASTERCARD
  if Is_MASTERCARD(N) then
    Result := csMASTERCARD
  else
  // MAESTRO
  if Is_MAESTRO(N) then
    Result := csMAESTRO
  else
  // VISA
  if Is_VISA(N) then
    Result := csVISA
  else
  // DISCOVER
  if Is_DISCOVER(N) then
    Result := csDISCOVER
  else
  // DINERSCLUB
  if Is_DINERSCLUB(N) then
    Result := csDINERSCLUBINTERNATIONAL
  else
  // JCB
  if Is_JCB(N) then
    Result := csJCB
  else
  // UNIONPAY
  if Is_UNIONPAY(N) then
    Result := csUNIONPAY
  else
  // RUPAY
  if Is_RUPAY(N) then
    Result := csRUPAY
  else
  // TROY
  if Is_TROY(N) then
    Result := csTROY
  else
  // DINACARD
  if Is_DINACARD(N) then
    Result := csDINACARD
  else
  // VERVE
  if Is_VERVE(N) then
    Result := csVERVE
  else
  // MIR
  if Is_MIR(N) then
    Result := csMIR
  else
  // UNKNOWN
  Result := csUNKNOWN;
end;

{*******************************************************}
{                     Format PAN                        }
{*******************************************************}
function FormatPAN(const N: string; const S: TCardScheme) : string;
begin
  // AMEX
  if (S = 01) then
  begin
    Result := Copy(N, 1, 4) + ' ' + Copy(N, 5, 6) + ' ' + Copy(N, 11, 5);
  end else
  // DINERS CLUB
  if (S = 15) then
  begin
    Result := Copy(N, 1, 4) + ' ' + Copy(N, 5, 6) + ' ' + Copy(N, 11, 4);
  end else
  // DISCOVER, JCB, MAESTRO, MASTERCARD, VISA
  if (S = 16) or (S = 27) or (S = 30) or (S = 31) or (S = 47) then
  begin
    Result := Copy(N, 1, 4) + ' ' + Copy(N, 5, 4) + ' ' + Copy(N, 9, 4) + ' ' + Copy(N, 13, 4);
  end else
  begin
    Result := N;
  end;
end;

end.
