function Is_AMEX(const N: string) : Boolean;
var
  X : Integer;
begin
  Result := False;
  if TryStrToInt(Copy(N, 1, 2), X) then
  begin
    Result := (Length(N) = 15) and ((X = 37) or (X = 34));
  end;
end;

