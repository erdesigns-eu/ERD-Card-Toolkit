unit untMemoryCardRead;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Imaging.pngimage,
  Vcl.ExtCtrls, untPCSC, untUSB, Registry;

type
  TfrmMemoryCardRead = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnHelp: TButton;
    btnRead: TButton;
    gbReader: TGroupBox;
    cbReader: TComboBox;
    pnlCardHolder: TPanel;
    gbAddress: TGroupBox;
    edtAddress: TEdit;
    gbLength: TGroupBox;
    edtLength: TEdit;
    gbResponse: TGroupBox;
    memResponse: TMemo;
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormCreate(Sender: TObject);
    procedure btnReadClick(Sender: TObject);
  private
    { Private declarations }
    PCSC         : TPCSC;
    FUSBNotifier : TComponentUSB;

    procedure USBArrivalRemoval(Sender: TObject);
  public
    { Public declarations }
  end;

var
  frmMemoryCardRead: TfrmMemoryCardRead;

implementation

{$R *.dfm}

uses untConst, untEMVTools, untAPDUParser, Math;

{*******************************************************}
{               USB Insert/Remove Event                 }
{*******************************************************}
procedure TfrmMemoryCardRead.USBArrivalRemoval(Sender: TObject);
begin
  // Reload SmartCard Reader/Writers
  PCSC.Init;
  // Populate list
  cbReader.Items.Assign(PCSC.ReaderList);
  if cbReader.Items.Count > 0 then
  begin
    PCSC.UseReaderNum := 0;
    cbReader.ItemIndex := 0;
  end;
  // Disconnect PCSC
  PCSC.Disconnect;
  PCSC.Close;
end;

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmMemoryCardRead.FormCreate(Sender: TObject);
var
  R : TRegistry;
begin
  // Set width and height
  Width  := 640;
  Height := 480;
  // Create PCSC
  PCSC := TPCSC.Create;
  PCSC.Init;
  // Populate SmartCard readers/writers
  cbReader.Items.Assign(PCSC.ReaderList);
  if cbReader.Items.Count > 0 then
  begin
    R := TRegistry.Create;
    try
      R.RootKey := HKEY_CURRENT_USER;
      if R.OpenKey(ApplicationRegKey, True) and R.ValueExists(PCSCDefault) then
      begin
        cbReader.ItemIndex := cbReader.Items.IndexOf(R.ReadString(PCSCDefault));
        PCSC.UseReaderNum := cbReader.ItemIndex;
      end else
      begin
        PCSC.UseReaderNum := 0;
        cbReader.ItemIndex := 0;
      end;
    finally
      R.Free;
    end;
  end;
  // Disconnect PCSC
  PCSC.Disconnect;
  PCSC.Close;
  // Create USB insert/remove notifier component
  FUSBNotifier := TComponentUSB.Create(Self);
  FUSBNotifier.OnUSBArrival := USBArrivalRemoval;
  FUSBNotifier.OnUSBRemove  := USBArrivalRemoval;
  // Clear response memo
  memResponse.Clear;
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmMemoryCardRead.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  // Free USB insert/remove notifier component
  FUSBNotifier.Destroy;
  // Free PCSC
  PCSC.Free;
  // Free Form
  Action := caFree;
  Release;
end;

{*******************************************************}
{                   Read Memory Card                    }
{*******************************************************}
procedure TfrmMemoryCardRead.btnReadClick(Sender: TObject);

  function ReadMemoryCard(const Address: AnsiString; const Length: AnsiString) : string;
  begin
    Result := Bin2HexExt(PCSC.GetResponseFromCard(Hex2Bin(
      Format('FFB000%s%s', [Address, Length])
    )));
  end;

  function FormatData(const D: string) : string;
  var
    I, X : Integer;
  begin
    Result := '';
    X := 1;
    for I := 1 to Ceil(Length(D) / 2) do
    begin
      Result := Result + Copy(D, X, 2) + ' ';
      Inc(X, 2);
    end;
    Result := Trim(Result);
  end;

const
  DataLen = 32;
var
  S : AnsiString;
  P : TAPDUParser;
  I,
  L : Integer;
  B : Boolean;
begin
  B := True;
  if not TryStrToInt('$' + edtAddress.Text, L) then
  begin
    B := False;
    Application.MessageBox('Address needs to be valid HEX format!', ApplicationTitle, MB_ICONWARNING or MB_OK);
  end;
  if not TryStrToInt('$' + edtLength.Text, L) then
  begin
    B := False;
    Application.MessageBox('Length needs to be valid HEX format!', ApplicationTitle, MB_ICONWARNING or MB_OK);
  end;
  if (cbReader.ItemIndex = -1) or (not B) then Exit;
  // Initialize Card Reader/Writer
  PCSC.Init;
  PCSC.UseReaderNum := cbReader.ItemIndex;
  if PCSC.Open and PCSC.Connect then
  with memResponse.Lines do
  begin
    BeginUpdate;
    // Clear
    Clear;
    // Header
    Add(MCReadHeader);
    // Read
    S := ReadMemoryCard(
      edtAddress.Text,
      edtLength.Text
    );
    // Create parser
    P := TAPDUParser.Create('', StringReplace(S, ' ', '', [rfReplaceAll]));
    try
      // SW 1
      Add(Format(MCReadRespSW1, [2, P.Response.SW1]));
      // SW 2
      Add(Format(MCReadRespSW2, [2, P.Response.SW2]));
      // Response code description
      Add(Format(MCReadRespStatus, [P.ResponseStatus.Description]));
      // Data
      L := 1;
      for I := 1 to Ceil(Length(P.Response.Data) / DataLen) do
      begin
        if I = 1 then
        begin
          Add(FormatData(Copy(P.Response.Data, L, DataLen)));
          Inc(L, DataLen);
        end else
        begin
          Add(FormatData(Copy(P.Response.Data, L, DataLen)));
          Inc(L, DataLen);
        end;
      end;
    finally
      P.Free;
    end;
    EndUpdate;
  end;
  PCSC.Disconnect;
  PCSC.Close;
end;

end.
