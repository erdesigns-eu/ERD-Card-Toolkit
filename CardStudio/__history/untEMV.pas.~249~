procedure TEMVCard.ReadCard;
var
  AIDList : TStringList;

  // Get P2 from SFI
  function SFIToP2(const Value: AnsiString) : Byte;
  var
    B : TBytes;
  begin
    SetLength(B, Length(Value) div 2);
    HexToBin(PAnsiChar(Value), PByte(B), Length(B));
    Result := Byte(B[0] shl 3) or 4;
  end;

  // Load initial application and read available applications
  procedure LoadInitialApplication(const AID: AnsiString; const AIDStr: AnsiString);
  var
    I : Integer;
    P : TASNParser;
    A : TASNItem;
    B : Byte;

    Application           : TEMVApplication;
    ApplicationFile       : TEMVApplicationFile;
    ApplicationFileRecord : TEMVApplicationFileRecord;
    RecordIndex           : Integer;
    RecordSW1             : Byte;
    RecordSW2             : Byte;
  begin
    P := TASNParser.Create;
    try
      // Select initial application
      P.Parse(SelectApplication(AID));
      // Check if application data is loaded
      if P.Items.Count > 0 then
      begin
        // Create Application
        Application := TEMVApplication.Create(AIDStr);
        // Try find tag 88 (SFI) so we can get a list of applications
        A := FindTag(P.Items.Items[0], '88');
        if Assigned(A) then
        begin
          // Get P2 from SFI
          B := SFIToP2(A.Value);
          // Create File
          ApplicationFile := TEMVApplicationFile.Create(1);
          // Read Records
          RecordIndex := 0;
          //
          RecordSW1 := $00;
          RecordSW2 := $00;
          while (RecordSW1 <> $6A) and (RecordSW2 <> $83) do
          begin
            ApplicationFileRecord := TEMVApplicationFileRecord.Create(RecordIndex +1);
            P.Parse(ReadRecord(RecordIndex +1, B, RecordSW1, RecordSW2), ApplicationFileRecord.Items);
            if (ApplicationFileRecord.Items.Count > 0) then
            begin
              // If the first tag is 70 (AEF)
              if ApplicationFileRecord.Items.Items[0].Tag = '70' then
              begin
                for I := 0 to ApplicationFileRecord.Items[0].Children.Count -1 do
                if ApplicationFileRecord.Items[0].Children.Items[I].Tag = '61' then
                begin
                  // Try find Application Identifier
                  A := FindTag(ApplicationFileRecord.Items[0].Children.Items[I], '4F');
                  // If we found the AID, add it to the list.
                  if Assigned(A) then AIDList.Add(A.Value);
                end;
              end;
              // Add record to Application File
              ApplicationFile.Records.Add(ApplicationFileRecord);
            end else
              ApplicationFileRecord.Free;
            // Increase record index
            Inc(RecordIndex);
          end;
          // Add Application File to the Application
          Application.Files.Add(ApplicationFile);
        end;
        // Add items to application
        for I := P.Items.Count -1 downto 0 do
        Application.Items.Add(P.Items.ExtractAt(I));
        // Add application to applications list
        Applications.Add(Application);
      end;
    finally
      P.Free;
    end;
  end;

  // Try to split Log Format to Tags
  procedure ParseLogFormat(const Application: TEMVApplication);

    function FindEMVTag(const Tag: AnsiString) : Integer;
    var
      I : Integer;
    begin
      // Default
      Result := -1;
      // Loop over tag list
      for I := Low(EMVTagList) to High(EMVTagList) do
      if EMVTagList[I].Tag = Trim(Uppercase(Tag)) then
      begin
        // Found!
        Result := I;
        Break;
      end;
    end;

  var
    I : Integer;
    X : Integer;
    L : AnsiString;
  begin
    I := 1;
    L := Application.LogFormat.Value;
    while I < Length(L) do
    begin
      X := FindEMVTag(Copy(L, I, 2));
      if (X > -1) then
      begin
        Application.LogFormatTagList.Add(TEMVLogFormatTag.Create(EMVTagList[X].Tag, EMVTagList[X].Name, StrToInt(Copy(L, I +2, 2))));
        Inc(I, 4);
      end else
      begin
        X := FindEMVTag(Copy(L, I, 4));
        if (X > -1) then
        Application.LogFormatTagList.Add(TEMVLogFormatTag.Create(EMVTagList[X].Tag, EMVTagList[X].Name, StrToInt(Copy(L, I +4, 2))));
        Inc(I, 6);
      end;
    end;
  end;

  // Process found AID's
  procedure ProcessAID(const AID: AnsiString);
  var
    I : Integer;
    X : Integer;
    Z : Byte;
    P : TASNParser;

    Application              : TEMVApplication;
    ApplicationFile          : TEMVApplicationFile;
    ApplicationFileRecord    : TEMVApplicationFileRecord;

    ApplicationLogFile       : TEMVApplicationLogFile;
    ApplicationLogFileRecord : TEMVApplicationLogRecord;
                             
    RecordIndex              : Integer;
    RecordSW1                : Byte;
    RecordSW2                : Byte;

    ProcessingSW1            : Byte;
    ProcessingSW2            : Byte;

    GetDataSW1               : Byte;
    GetDataSW2               : Byte;
  begin
    P := TASNParser.Create;
    try
      // Select initial application
      P.Parse(SelectApplication(AID));
      // Check if application data is loaded
      if P.Items.Count > 0 then
      begin
        // Create Application
        Application := TEMVApplication.Create(AID);
        // Add items to application
        for I := P.Items.Count -1 downto 0 do
        Application.AnswerToSelect.Add(P.Items.ExtractAt(I));
        // Get Processing options
        P.Parse(ProcessingOptions(Application, ProcessingSW1, ProcessingSW2), Application.ProcessingOptions);
        // Application files + records
        // Loop SFI 1 - 10
        for X := 1 to 10 do
        begin
          // Create File
          ApplicationFile := TEMVApplicationFile.Create(X);
          // Loop Records 1 - 6
          for Z := 1 to 6 do
          begin
            P.Items.Clear;
            ApplicationFileRecord := TEMVApplicationFileRecord.Create(Z);
            P.Parse(ReadRecord(Z, _SFIList[X], RecordSW1, RecordSW2), ApplicationFileRecord.Items);
            if (ApplicationFileRecord.Items.Count > 0) then
            begin
              // Add record to Application File
              ApplicationFile.Records.Add(ApplicationFileRecord);
            end else
              ApplicationFileRecord.Free;
          end;
          if ApplicationFile.Records.Count > 0 then
            Application.Files.Add(ApplicationFile)
          else
            ApplicationFile.Free;
        end;
        // ATC (Application Transaction Counter)
        P.Parse(GetData($36, GetDataSW1, GetDataSW2));
        if (GetDataSW1 = $90) and (GetDataSW2 = $00) then
        begin
          Application.ATC.Assign(P.Items.Items[0]);
          P.Items.Clear;
        end;
        // Last Online ATC Register
        P.Parse(GetData($13, GetDataSW1, GetDataSW2));
        if (GetDataSW1 = $90) and (GetDataSW2 = $00) then
        begin
          Application.LastOnlineATCRegister.Assign(P.Items.Items[0]);
          P.Items.Clear;
        end;
        // Pin Try Counter
        P.Parse(GetData($17, GetDataSW1, GetDataSW2));
        if (GetDataSW1 = $90) and (GetDataSW2 = $00) then
        begin
          Application.PinTryCounter.Assign(P.Items.Items[0]);
          P.Items.Clear;
        end;
        // Log Format
        P.Parse(GetData($4F, GetDataSW1, GetDataSW2));
        if (GetDataSW1 = $90) and (GetDataSW2 = $00) then
        begin
          Application.LogFormat.Assign(P.Items.Items[0]);
          // Try to parse Log Format result to Tags
          ParseLogFormat(Application);
          P.Items.Clear;
        end;
        // Application Log files + records
        // Loop SFI 11 - 30
        for X := 11 to 30 do
        begin
          // Create Log File
          ApplicationLogFile := TEMVApplicationLogFile.Create(X);
          // Loop Records 1 - 10
          for Z := 1 to 10 do
          begin
            ApplicationLogFileRecord := TEMVApplicationLogRecord.Create(Z, ReadRecord(Z, _SFIList[X], RecordSW1, RecordSW2), Application.LogFormatTagList);
            if (ApplicationLogFileRecord.Value <> '') then
            begin
              // Add record to Application Log File
              ApplicationLogFile.Records.Add(ApplicationLogFileRecord);
            end else
              ApplicationLogFileRecord.Free;
          end;
          if ApplicationLogFile.Records.Count > 0 then
            Application.LogFiles.Add(ApplicationLogFile)
          else
            ApplicationLogFile.Free;
        end;
        // Add application to applications list
        Applications.Add(Application);
      end;
    finally
      P.Free;
    end;
  end;

var
  I : Integer;
begin
  AIDList := TStringList.Create;
  try
    // Clear Data
    Clear;
    // Try parse and find ATR
    ATR.ParseATR(CardReader.AttrCardATR);
    // Try read CPCL Data
    CPCL.ParseCPCL(GetCPCL);
    // Try load AID's from Contact Application 
    LoadInitialApplication(AIDP1, {'1PAY.SYS.DDF01'}AIDP1);
    // Try load AID's from Contactless Application
    LoadInitialApplication(AIDP2, {'1PAY.SYS.DDF02'}AIDP2);
    // If no application AID's are found, add the known AID's to the list
    if (AIDList.Count = 0) then
    for I := Low(_AIDLIst) to High(_AIDList) do AIDList.Add(_AIDList[I]);
    // Process found AID's
    for I := 0 to AIDList.Count -1 do ProcessAID(AIDList[I]);
  finally
    AIDList.Free;
  end;
end;

procedure TEMVCard.LoadTree(var TreeView: TTreeView);

  function AddTreeNode(const Parent: TTreeNode; const Caption: string; const ImageIndex: Integer) : TTreeNode;
  var
    N : TTreeNode;
  begin
    N := TreeView.Items.AddChild(Parent, Caption);
    N.ImageIndex := ImageIndex;
    N.SelectedIndex := ImageIndex;
    N.StateIndex := ImageIndex;
    N.ExpandedImageIndex := ImageIndex;
    Result := N;
  end;

  procedure ASNTree(const ASN: TASNItem; const TreeNode: TTreeNode; const ImageIndex: Integer);
  var
    I : Integer;
    N : TTreeNode;
  begin
    // Add TreeNode
    if ASN.Name <> '' then
      N := AddTreeNode(TreeNode, ASN.Name, ImageIndex)
    else
      N := AddTreeNode(TreeNode, ASN.Tag, ImageIndex);
    // Add children
    for I := 0 to ASN.Children.Count -1 do ASNTree(ASN.Children[I], N, ImageIndex);
  end;

var
  R : TTreeNode; // Root Node - Card
  A : TTreeNode; // Application Node
  F : TTreeNode; // File Node
  N : TTreeNode; // Other Node
  I : Integer;
  X : Integer;
  Y : Integer;
  Z : Integer;
begin
  // Card - Root Node
  R := AddTreeNode(nil, 'Card', 0);
  // Card ATR
  A := AddTreeNode(R, 'ATR', 0);
  AddTreeNode(A, 'Scheme', 3);
  AddTreeNode(A, 'Type', 3);
  AddTreeNode(A, 'Country', 3);
  AddTreeNode(A, 'Issuer', 3);
  AddTreeNode(A, 'Category', 3);
  // Applications
  for I := 0 to Applications.Count -1 do
  begin
    // Add Application
    if AnsiCompareStr(Applications.Items[I].AID, AIDP1) = 0 then
      A := AddTreeNode(R, '1PAY.SYS.DDF01', 1)
    else
    if AnsiCompareStr(Applications.Items[I].AID, AIDP1) = 0 then
      A := AddTreeNode(R, '1PAY.SYS.DDF02', 1)
    else
      A := AddTreeNode(R, Applications.Items[I].AID, 1);
    // Add Items
    if (Applications.Items[I].Items.Count > 0) then
    for X := 0 to Applications.Items[I].Items.Count -1 do
    ASNTree(Applications.Items[I].Items[X], A, 3);
    // Add Answer to Select
    if (Applications.Items[I].AnswerToSelect.Count > 0) then
    begin
      N := AddTreeNode(A, 'Answer to Select', 2);
      for X := 0 to Applications.Items[I].AnswerToSelect.Count -1 do
      ASNTree(Applications.Items[I].AnswerToSelect[X], N, 3);
    end;
    // Add Processing Options
    if (Applications.Items[I].ProcessingOptions.Count > 0) then
    begin
      N := AddTreeNode(A, 'Processing Options', 2);
      for X := 0 to Applications.Items[I].ProcessingOptions.Count -1 do
      ASNTree(Applications.Items[I].ProcessingOptions[X], N, 3);
    end;
    // Add Files
    if (Applications.Items[I].Files.Count > 0) then
    for X := 0 to Applications.Items[I].Files.Count -1 do
    begin
      F := AddTreeNode(A, Format('File %d', [Applications.Items[I].Files.Items[X].FileIndex]), 2);
      for Y := 0 to Applications.Items[I].Files.Items[X].Records.Count -1 do
      begin
        N := AddTreeNode(F, Format('Record %d', [Applications.Items[I].Files.Items[X].Records.Items[Y].RecordIndex]), 2);
        for Z := 0 to Applications.Items[I].Files.Items[X].Records.Items[Y].Items.Count -1 do
        ASNTree(Applications.Items[I].Files.Items[X].Records.Items[Y].Items.Items[Z], N, 3);
      end;
    end; 
    // Add Log Files
    if (Applications.Items[I].LogFiles.Count > 0) then
    for X := 0 to Applications.Items[I].LogFiles.Count -1 do
    begin
      F := AddTreeNode(A, Format('Log File %d', [Applications.Items[I].LogFiles.Items[X].FileIndex]), 2);
      for Y := 0 to Applications.Items[I].LogFiles.Items[X].Records.Count -1 do
      begin
        N := AddTreeNode(F, Format('Record %d', [Applications.Items[I].LogFiles.Items[X].Records.Items[Y].RecordIndex]), 2);
        for Z := 0 to Applications.Items[I].LogFiles.Items[X].Records.Items[Y].Items.Count -1 do
        AddTreeNode(N, Applications.Items[I].LogFiles.Items[X].Records.Items[Y].Items.Items[Z].Name, 3);
      end;
    end; 
    // ATC
    if (Applications.Items[I].ATC.Name <> '') then
    AddTreeNode(A, Applications.Items[I].ATC.Name, 3);
    // Last Online ATC Register
    if (Applications.Items[I].LastOnlineATCRegister.Name <> '') then
    AddTreeNode(A, Applications.Items[I].LastOnlineATCRegister.Name, 3);
    // Pin Try Counter
    if (Applications.Items[I].PinTryCounter.Name <> '') then
    AddTreeNode(A, Applications.Items[I].PinTryCounter.Name, 3);
    // Log Format
    if (Applications.Items[I].LogFormat.Name <> '') then
    AddTreeNode(A, Applications.Items[I].LogFormat.Name, 3);
  end;
  // Card CPCL
  A := AddTreeNode(R, 'CPCL', 0);
  AddTreeNode(A, 'Fabricator', 3);
  AddTreeNode(A, 'IC Type', 3);
  AddTreeNode(A, 'Operating System Provider Identifier', 3);
  AddTreeNode(A, 'Operating System Release Date', 3);
  AddTreeNode(A, 'Operating System Release Level', 3);
  AddTreeNode(A, 'IC Fabrication Date', 3);
  AddTreeNode(A, 'IC Serial Number', 3);
  AddTreeNode(A, 'IC Batch Identifier', 3);
  AddTreeNode(A, 'IC Module Fabricator', 3);
  AddTreeNode(A, 'IC Module Packaging Date', 3);
  AddTreeNode(A, 'ICC Manufacturer', 3);
  AddTreeNode(A, 'IC Embedding Date', 3);
  AddTreeNode(A, 'Prepersonalizer Identifier', 3);
  AddTreeNode(A, 'Perpersonalization Date', 3);
  AddTreeNode(A, 'Perpersonalization Equipment', 3);
  AddTreeNode(A, 'Personalizer Identifier', 3);
  AddTreeNode(A, 'Personalization Date', 3);
  AddTreeNode(A, 'Personalization Equipment', 3);
end;

procedure TEMVCard.LoadFromFile(const Filename: string);

  procedure ASNItem(Parent: TASNItemList; Item: TJSonValue); overload;
  var
    I : Integer;
    A : TJSONArray;
    N : TASNItem;
  begin
    // Create ASN Item
    N := TASNItem.Create;

    // Read Values
    N.&Class       := StrToTagClasses((Item as TJSONObject).Get('Class').JsonValue.GetValue<string>);
    N.Flag         := StrToConstructedFlag((Item as TJSONObject).Get('Constructed Flag').JsonValue.GetValue<string>);
    N.Name         := (Item as TJSONObject).Get('Name').JsonValue.GetValue<string>;
    N.Tag          := (Item as TJSONObject).Get('Tag').JsonValue.GetValue<string>;
    N.Value        := (Item as TJSONObject).Get('Value').JsonValue.GetValue<string>;
    N.ValueType    := StrToTagValueType((Item as TJSONObject).Get('Value Type').JsonValue.GetValue<string>);
    N.HeaderLength := (Item as TJSONObject).Get('Header Length').JsonValue.GetValue<Integer>;
    N.Length       := (Item as TJSONObject).Get('Length').JsonValue.GetValue<Integer>;

    // Create children
    A := (Item as TJSONObject).Get('Items').JsonValue as TJSONArray;
    for I := 0 to A.Count -1 do ASNItem(N.Children, (A.Items[I] as TJSONValue));
    // Add to parent
    Parent.Add(N);
  end;

  function ASNItem(const Item: TJSONValue) : TASNItem; overload;
  var
    I : Integer;
    A : TJSONArray;
  begin
    // Create ASN Item
    Result := TASNItem.Create;

    // Read Values
    Result.&Class       := StrToTagClasses((Item as TJSONObject).Get('Class').JsonValue.GetValue<string>);
    Result.Flag         := StrToConstructedFlag((Item as TJSONObject).Get('Constructed Flag').JsonValue.GetValue<string>);
    Result.Name         := (Item as TJSONObject).Get('Name').JsonValue.GetValue<string>;
    Result.Tag          := (Item as TJSONObject).Get('Tag').JsonValue.GetValue<string>;
    Result.Value        := (Item as TJSONObject).Get('Value').JsonValue.GetValue<string>;
