function TEMVCard.FindTag(const ASN: TASNItem; const Tag: AnsiString) : TASNItem;
var
  I : Integer;
  A : TASNItem;
begin
  Result := nil;
  if AnsiCompareText(ASN.Tag, Tag) = 0 then
    Result := ASN
  else
    for I := 0 to ASN.Children.Count -1 do
    begin
      A := FindTag(ASN.Children.Items[I], Tag);
      if Assigned(A) then Result := A;
    end;
end;

