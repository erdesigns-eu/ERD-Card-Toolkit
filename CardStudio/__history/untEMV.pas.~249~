    Result.HeaderLength := (Item as TJSONObject).Get('Header Length').JsonValue.GetValue<Integer>;
    Result.Length       := (Item as TJSONObject).Get('Length').JsonValue.GetValue<Integer>;

    // Create children
    A := (Item as TJSONObject).Get('Items').JsonValue as TJSONArray;
    for I := 0 to A.Count -1 do ASNItem(Result.Children, (A.Items[I] as TJSONValue));
  end;

