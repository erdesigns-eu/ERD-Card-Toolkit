  function ApplicationAPDULine(const Application: TEMVApplication; const Item: TASNItem) : AnsiString;
  var
    L : Integer;
    S : AnsiString;
    X : AnsiString;
  begin
    // Clear Result
    Result := '';
    // Format APDU
    X := Format('%s%.*x%s', [Item.Tag, 2, Length(Item.Value) div 2, Item.Value]);
    S := Format('00A40400%.*x%s%.*x%s', [2, Length(Application.AID) div 2, Application.AID, 2, Length(X) div 2, X]);
    L := (Length(S) div 2) +1;
    // Format Result
    if (L > 0) then Result := Format('%s00A40102%.*x%.*x%s', [ISTAPDUPrefix, 2, L, 2, L, S]);
  end;

  function ProcessingOptionsAPDULine(const Item: TASNItem) : AnsiString;
  var
    L : Integer;
    S : AnsiString;
    X : AnsiString;
  begin
    // Clear Result
    Result := '';
    // Format APDU
    X := Format('%s%.*x%s', [Item.Tag, 2, Length(Item.Value) div 2, Item.Value]);
    S := Format('80A8000000%.*x%s', [2, Length(X) div 2, X]);
    L := (Length(S) div 2) +1;
    // Format Result
    if (L > 0) then Result := Format('%s00A40102%.*x%.*x%s', [ISTAPDUPrefix, 2, L, 2, L, S]);
  end;

  function RecordAPDULine(const Item: TASNItem; const FileIndex: Integer; const RecordIndex: Integer) : AnsiString;
  var
    L : Integer;
    S : AnsiString;
    X : AnsiString;
  begin
    // Clear Result
    Result := '';

    //
    X := Item.Tag;
    S := Item.Value;

    // Length of Value
    L := System.Length(Item.Value) div 2;
    // Format APDU
    if (L >= 100) then
      X := Format('%s81%.*x%s', [Item.Tag, 2, L, Item.Value])
    else
      X := Format('%s%.*x%s', [Item.Tag, 2, L, Item.Value]);
    // Format APDU
    S := Format('00B2%.*x%.*x00%.*x%s', [2, RecordIndex, 2, _SFIList[FileIndex], 2, Length(X) div 2, X]);
    L := Length(S);
    L := (Length(S) div 2) +1;
    // Format Result
    if (L > 0) then
    begin
      if (L > 255) then
        Result := Format('%s00A40102%.*x%s', [ISTAPDUPrefix, 6, L, S])
      else
        Result := Format('%s00A40102%.*x%.*x%s', [ISTAPDUPrefix, 2, L, 2, L, S]);
    end;
    //if (L > 0) then Result := Format('%s00A40102%.*x%.*x%s', [ISTAPDUPrefix, 2, L, 2, L, S]);
  end;

