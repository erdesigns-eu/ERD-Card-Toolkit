var
  S : TStringList;
  F : TJSONObject;
  I : Integer;
  X : Integer;

  ATRJ, CPCLJ, APPJ                    : TJSONObject;
  APPA, ITMA, ATSA, POA, LFTA, FA, LFA : TJSONArray;
begin
  S := TStringList.Create;
  F := TJSONObject.Create;
  try
    // ATR
    ATRJ := TJSONObject.Create;
    ATRJ.AddPair('Scheme', CardSchemeToStr(ATR.Scheme));
    ATRJ.AddPair('Type', CardTypeToStr(ATR.&Type));
    ATRJ.AddPair('Country', TJSONNumber.Create(ATR.Country));
    ATRJ.AddPair('Issuer', ATR.Issuer);
    ATRJ.AddPair('Category', ATR.Category);
    ATRJ.AddPair('Value', ATR.Value);
    F.AddPair('ATR', ATRJ);

    // Applications
    APPA := TJSONArray.Create;
    for I := 0 to Applications.Count -1 do
    begin
      APPJ := TJSONObject.Create;
      // Application AID
      APPJ.AddPair('AID', Applications.Items[I].AID);
      // Items
      ITMA := TJSONArray.Create;
      for X := 0 to Applications.Items[I].Items.Count -1 do
      EMVTag(ITMA, Applications.Items[I].Items[X]);
      APPJ.AddPair('Items', ITMA);
      // Answer to Select
      ATSA := TJSONArray.Create;
      for X := 0 to Applications.Items[I].AnswerToSelect.Count -1 do
      EMVTag(ATSA, Applications.Items[I].AnswerToSelect[X]);
      APPJ.AddPair('Answer to Select', ATSA);
      // Processing Options
      POA := TJSONArray.Create;
      for X := 0 to Applications.Items[I].ProcessingOptions.Count -1 do
      EMVTag(POA, Applications.Items[I].ProcessingOptions[X]);
      APPJ.AddPair('Processing Options', POA);
      // ATC
      APPJ.AddPair('ATC', EMVTag(Applications.Items[I].ATC));
      // Last Online ATC Register
      APPJ.AddPair('Last Online ATC Register', EMVTag(Applications.Items[I].LastOnlineATCRegister));
      // PinTryCounter
      APPJ.AddPair('Pin Try Counter', EMVTag(Applications.Items[I].PinTryCounter));
      // Log Format
      APPJ.AddPair('Log Format', EMVTag(Applications.Items[I].LogFormat));
      // Log Format Tag List
      LFTA := TJSONArray.Create;
      for X := 0 to Applications.Items[I].LogFormatTagList.Count -1 do
      LFTA.Add(LogFormatTag(Applications.Items[I].LogFormatTagList.Items[X]));
      APPJ.AddPair('Log Format Tag List', LFTA);
      // Files
      FA := TJSONArray.Create;
      for X := 0 to Applications.Items[I].Files.Count -1 do
      FA.Add(ApplicationFile(Applications.Items[I].Files.Items[X]));
      APPJ.AddPair('Files', FA);
      // Log Files
      LFA := TJSONArray.Create;
      for X := 0 to Applications.Items[I].LogFiles.Count -1 do
      LFA.Add(ApplicationLogFile(Applications.Items[I].LogFiles.Items[X]));
      APPJ.AddPair('Log Files', LFA);
      // Add Application to Array
      APPA.Add(APPJ);
    end;
    F.AddPair('Applications', APPA);

    // CPCL
    CPCLJ := TJSONObject.Create;
    CPCLJ.AddPair('IC Type', CPCL.ICType);
    CPCLJ.AddPair('Operating System Provider Identifier', CPCL.OperatingSystemProviderIdentifier);
    CPCLJ.AddPair('Operating System Release Date', CPCL.OperatingSystemReleaseDate);
    CPCLJ.AddPair('Operating System Release Level', CPCL.OperatingSystemReleaseLevel);
    CPCLJ.AddPair('IC Fabrication Date', CPCL.ICFabricationDate);
    CPCLJ.AddPair('IC Serial Number', CPCL.ICSerialNumber);
    CPCLJ.AddPair('IC Batch Identifier', CPCL.ICBatchIdentifier);
    CPCLJ.AddPair('IC Module Fabricator', CPCL.ICModuleFabricator);
    CPCLJ.AddPair('IC Module Packaging Date', CPCL.ICModulePackagingDate);
    CPCLJ.AddPair('IC Manufacturer', CPCL.ICCManufacturer);
    CPCLJ.AddPair('IC Embedding Date', CPCL.ICEmbeddingDate);
    CPCLJ.AddPair('Prepersonalizer Identifier', CPCL.PrepersonalizerIdentifier);
    CPCLJ.AddPair('Prepersonalization Date', CPCL.PrepersonalizationDate);
    CPCLJ.AddPair('Prepersonalization Equipment', CPCL.PrepersonalizationEquipment);
    CPCLJ.AddPair('Personalizer Identifier', CPCL.PersonalizerIdentifier);
    CPCLJ.AddPair('Personalization Date', CPCL.PersonalizationDate);
    CPCLJ.AddPair('Personalization Equipment', CPCL.PersonalizationEquipment);
    F.AddPair('CPCL', CPCLJ);

    // Create JSON
    S.Text := F.ToJSON;
    // Save JSON to File
    S.SaveToFile(Filename, TEncoding.UTF8);
  finally
    S.Free;
    F.Free;
  end;
end;

