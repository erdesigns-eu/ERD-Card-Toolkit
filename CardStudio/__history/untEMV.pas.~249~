  procedure Application(const Item: TJSONValue);
  var
    A : TEMVApplication;
    X : TJSONArray;
    I : Integer;
  begin
    // Application AID
    A := TEMVApplication.Create((Item as TJSONObject).Get('AID').JSONValue.GetValue<string>);
    // Items
    X := (Item as TJSONObject).Get('Items').JsonValue as TJSONArray;
    for I := 0 to X.Count -1 do ASNItem(A.Items, X.Items[I]);
    // Answer to Select
    X := (Item as TJSONObject).Get('Answer to Select').JsonValue as TJSONArray;
    for I := 0 to X.Count -1 do ASNItem(A.AnswerToSelect, X.Items[I]);
    // Processing Options
    X := (Item as TJSONObject).Get('Processing Options').JsonValue as TJSONArray;
    for I := 0 to X.Count -1 do ASNItem(A.ProcessingOptions, X.Items[I]);
    // ATC
    A.ATC := ASNItem((Item as TJSONObject).Get('ATC').JsonValue);
    // Last Online ATC Register
    A.LastOnlineATCRegister := ASNItem((Item as TJSONObject).Get('Last Online ATC Register').JsonValue);
    // Pin Try Counter
    A.PinTryCounter := ASNItem((Item as TJSONObject).Get('Pin Try Counter').JsonValue);
    // Log Format
    A.LogFormat := ASNItem((Item as TJSONObject).Get('Log Format').JsonValue);
    // Log Format Tag List
    X := (Item as TJSONObject).Get('Log Format Tag List').JsonValue as TJSONArray;
    for I := 0 to X.Count -1 do LogFormatTag(X.Items[I], A.LogFormatTagList);
    // Files
    X := (Item as TJSONObject).Get('Files').JsonValue as TJSONArray;
    for I := 0 to X.Count -1 do ApplicationFile(X.Items[I], A.Files);
    // Log Files
    X := (Item as TJSONObject).Get('Log Files').JsonValue as TJSONArray;
    for I := 0 to X.Count -1 do ApplicationLogFile(X.Items[I], A.LogFiles);
    // Add Application to Applications List
    Applications.Add(A);
  end;

