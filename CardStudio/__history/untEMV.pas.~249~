    L := (Length(S) div 2) +1;
    // Format Result
    if (L > 0) then Result := Format('%s00A40102%.*x%.*x%s', [ISTAPDUPrefix, 2, L, 2, L, S]);
  end;

  function CPCLLine : AnsiString;
  var
    L : Integer;
    S : AnsiString;
    X : AnsiString;
  begin
    // Clear Result
    Result := '';
    // Format APDU
    X := Format('%s%.*x%s', ['9F7F', 2, Length(CPCL.Value) div 2, CPCL.Value]);
    S := Format('80CA9F7F00%.*x%s', [2, Length(X) div 2, X]);
    L := (Length(S) div 2) +1;
    // Format Result
    if (L > 0) then Result := Format('%s00A40102%.*x%.*x%s', [ISTAPDUPrefix, 2, L, 2, L, S]);
  end;

var
  A : Integer;
  X : Integer;
  F : Integer;
  R : Integer;
  S : TStringList;
begin
  S := TStringList.Create;
  try
    with S do
    begin
      // Add Header
      Add(ISTHeader);
      Add('');
      // Mode 211
      Add('mode_211');
      // Establish Context
      Add('establish_context');
      // Enable Trace
      Add('enable_trace');
      // Enable Timer
      Add('enable_timer');
      // Connect cardreader
      Add('card_connect');
      // Add Applications
      if Applications.Count > 0 then
      begin
        // First AID
        Add(Format('%s00A40400%.*x%s', [ISTAPDUPrefix, 2, Length(Applications.Items[0].AID) div 2, Applications.Items[0].AID]));
        // Some Unknown APDU's (See X1 Source: Reader.cpp -> MakeVISA_IST)
        Add(Format('%s00a401060100', [ISTAPDUPrefix]));
        Add(Format('%s00a40101', [ISTAPDUPrefix]));
        Add(Format('%s00a40105', [ISTAPDUPrefix]));
        // Add Applications
        for A := 0 to Applications.Count -1 do
        begin
          // Application
          for X := 0 to Applications.Items[A].Items.Count -1 do
          Add(ApplicationAPDULine(Applications.Items[A], Applications.Items[A].Items[X]));
          for X := 0 to Applications.Items[A].AnswerToSelect.Count -1 do
          Add(ApplicationAPDULine(Applications.Items[A], Applications.Items[A].AnswerToSelect[X]));
          // Processing Options
          for X := 0 to Applications.Items[A].ProcessingOptions.Count -1 do
          Add(ProcessingOptionsAPDULine(Applications.Items[A].ProcessingOptions[X]));
          // Records
          for F := 0 to Applications.Items[A].Files.Count -1 do
          for R := 0 to Applications.Items[A].Files[F].Records.Count -1 do
          for X := 0 to Applications.Items[A].Files[F].Records[R].Items.Count -1 do
          Add(RecordAPDULine(Applications.Items[A].Files[F].Records[R].Items[X], Applications.Items[A].Files[F].FileIndex, Applications.Items[A].Files[F].Records[R].RecordIndex));
          // ATC
          if (Applications.Items[A].ATC.Value <> '') then
          Add(ATCAPDULine(Applications.Items[A].ATC));
          // Last ATC Online Register
          if (Applications.Items[A].LastOnlineATCRegister.Value <> '') then
          Add(LastOnlineATCRegisterLine(Applications.Items[A].LastOnlineATCRegister));
          // Pin Try Counter
          if (Applications.Items[A].PinTryCounter.Value <> '') then
          Add(PinTryCounterLine(Applications.Items[A].PinTryCounter));
          // Log Format
          if (Applications.Items[A].LogFormat.Value <> '') then
          Add(LogFormatLine(Applications.Items[A].LogFormat));
          //
          Add(Format('%s00A40102090900B2%.*X0C00026A83', [ISTAPDUPrefix, 2, X]));
        end;
      end;
      // Add CPCL
      if (CPCL.Value <> '') then Add(CPCLLine);

      Add(Format('%s00a40102323280ae8000002B77299F2701809F360200499F26088A3470B2406A11489F10120114A500030200003B0F00000000000000FF', [ISTAPDUPrefix]));
      Add(Format('%s00a40102323280ae4000002B77299F2701409F360200499F2608BA9A9D755485B3EC9F101201146500030200003B0F00000000000000FF', [ISTAPDUPrefix]));
      Add(Format('%s00a40102323280ae0000002B77299F2701009F360200499F26088A3470B2406A11489F10120114A500030200003B0F00000000000000FF', [ISTAPDUPrefix]));
      Add(Format('%s00a4010209090020008000029000', [ISTAPDUPrefix]));
      Add(Format('%s00a401060100', [ISTAPDUPrefix]));
      // Disconnect cardreader
      Add('card_disconnect');
      // Release context
      Add('release_context');
    end;
    // Save JSON to File
    S.SaveToFile(Filename, TEncoding.ANSI);
  finally
    S.Free;
  end;
end;

