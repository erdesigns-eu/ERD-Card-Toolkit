      // Wrong Length LE
      $6C: begin
             // ReAssemble APDU and send again
             APDU := Format('80 A8 00 00 %.*x', [2, P.Response.SW2]);
             GoTo Send;
           end;

      // Response Bytes still available
      $61: begin
             // GET RESPONSE
             APDU := Format('00 C0 00 00 %.*x', [2, P.Response.SW2]);
             // Concatenate
             Result := Result + P.Response.Data;
             GoTo Send;
           end;

      // Not Found
