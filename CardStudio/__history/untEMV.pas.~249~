{*******************************************************}
{              EMV Application Log Record               }
{*******************************************************}
constructor TEMVApplicationLogRecord.Create(const Index: Integer; const Value: AnsiString; const TagList: TEMVLogFormatTagList);
begin
  inherited Create;

  // Create Log Tag List
  FItems := TEMVLogTagList.Create(True);

  // Set Record Index
  FIndex := Index;
  // Set Record Value
  FValue := Value;

  // Parse Log Record
  ParseLogRecord(TagList);
end;

constructor TEMVApplicationLogRecord.Create(const Index: Integer; const Value: AnsiString);
begin
  // Create Log Tag List
  FItems := TEMVLogTagList.Create(True);

  // Set Record Index
  FIndex := Index;
  // Set Record Value
  FValue := Value;
end;

destructor TEMVApplicationLogRecord.Destroy;
begin
  // Free Log Tag Items List
  FItems.Free;

  inherited Destroy;
end;

procedure TEMVApplicationLogRecord.ParseLogRecord(const TagList: TEMVLogFormatTagList);
var
  I : Integer;
  P : Integer;
begin
  P := 1;
  for I := 0 to TagList.Count -1 do
  begin
    Items.Add(TEMVLogTag.Create(
      TagList.Items[I].Tag, 
      TagList.Items[I].Name, 
      TagList.Items[I].Length, 
      Copy(Value, P, TagList.Items[I].Length)
    ));
    Inc(P, TagList.Items[I].Length);
  end;
end;

