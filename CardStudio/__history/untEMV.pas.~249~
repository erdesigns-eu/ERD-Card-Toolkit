{*******************************************************}
{                      EMV Card ATR                     }
{*******************************************************}
procedure TEMVCardATR.ParseATR(const ATR: AnsiString);
var
  X : Integer;
  I : Integer;
begin
  FValue := StringReplace(Bin2HexExt(ATR, True, True), ' ', '', [rfReplaceAll]);
  //
  X := -1;
  // Try and find ATR in list
  for I := Low(ATRS) to High(ATRS) do
  begin
    if AnsiCompareStr(ATRS[I].atr_value, FValue) = 0 then
    begin
      X := I;
      Break;
    end;
  end;
  // 
  if (X > -1) then
  begin
    FScheme   := ATRS[X].atr_scheme;
    FType     := ATRS[X].atr_type;
    FCountry  := ATRS[X].atr_country;
    FIssuer   := ATRS[X].atr_issuer;
    FCategory := ATRS[X].atr_category;
  end else
  begin
    FScheme   := csUNKNOWN;
    FType     := ctUNKNOWN;
    FCountry  := ccUNKNOWN;
    FIssuer   := '';
    FCategory := '';
  end;
end;

{*******************************************************}
{                      EMV Card CPCL                    }
{*******************************************************}
procedure TEMVCardCPCL.ParseCPCL(const CPCL: AnsiString);
begin
  // Set RAW CPCL Data string
  FValue := String(CPCL);
  // Make sure we got a full CPCL data string
  if (Length(CPCL) < 84) then Exit;
  FICFabricator := Copy(CPCL, 1, 4);   // Fabricator
  FICType       := Copy(CPCL, 5, 4);   // IC Type
  FOSPI         := Copy(CPCL, 9, 4);   // Operating System Provider Identifier
  FOSRD         := Copy(CPCL, 13, 4);  // Operating System Release Date
  FOSRL         := Copy(CPCL, 17, 4);  // Operating System Release Level
  FICFabDate    := Copy(CPCL, 21, 4); // IC Fabrication Date
  FICSerial     := Copy(CPCL, 25, 8); // IC Serial Number
  FICBatchID    := Copy(CPCL, 33, 4); // IC Batch Identifier
  FICModFab     := Copy(CPCL, 37, 4); // IC Module Fabricator
  FICModPDate   := Copy(CPCL, 41, 4); // IC Module Packaging Date
  FICCManufact  := Copy(CPCL, 45, 4); // ICC Manufacturer
  FICEmbedDate  := Copy(CPCL, 49, 4); // IC Embedding Date
  FPPId         := Copy(CPCL, 53, 4); // Prepersonalizer Identifier
  FPPDate       := Copy(CPCL, 57, 4); // Perpersonalization Date
  FPPEquipment  := Copy(CPCL, 61, 8); // Perpersonalization Equipment
  FPersId       := Copy(CPCL, 69, 4); // Personalizer Identifier
  FPersDate     := Copy(CPCL, 73, 4); // Personalization Date
  FPEquipment   := Copy(CPCL, 77, 8); // Personalization Equipment 
end;

