{                        EMV Card                       }
{*******************************************************}
constructor TEMVCard.Create(const PCSC: TPCSC);
begin
  inherited Create;

  // Assign Card Reader
  FCardReader := PCSC;
  // Create ATR
  FATR := TEMVCardATR.Create;
  // Create CPCL
  FCPCL := TEMVCardCPCL.Create;
  // Create Applications List
  FApplications := TEMVApplicationList.Create(True);
  // Create Log Strings
  FLog := TStringList.Create;
end;

destructor TEMVCard.Destroy;
begin
  // Free ATR
  FATR.Free;
  // Free CPCL
  FCPCL.Free;
  // Free Applications List
  FApplications.Free;
  // FRee Log Strings
  FLog.Free;

  inherited Destroy;
end;

function TEMVCard.SendAPDU(const APDU: AnsiString) : AnsiString;
begin
  Result := Bin2HexExt(CardReader.GetResponseFromCard(Hex2Bin(APDU)));
  // Add to Log
  FLog.Add(Format('SEND: %s', [FormatData(StringReplace(APDU, ' ', '', [rfReplaceAll]))]));
  FLog.Add(Format('RECV: %s', [FormatData(StringReplace(Result, ' ', '', [rfReplaceAll]))]));
  // If Log Event is assigned
  if Assigned(FOnLog) then FOnLog(Self, APDU, Result);
end;

function TEMVCard.FormatData(const Data: AnsiString) : AnsiString;
var
  I, X : Integer;
begin
  Result := '';
  X := 1;
  for I := 1 to Ceil(Length(Data) / 2) do
  begin
    Result := Result + Copy(Data, X, 2) + ' ';
    Inc(X, 2);
  end;
  Result := Trim(Result);
end;

function TEMVCard.SelectApplication(const AID: AnsiString) : AnsiString;
var
  P : TAPDUParser;
  A : AnsiString;
label
  Send;
begin
  P := TAPDUParser.Create('', '');
  try
    // Clear Result
    Result := '';
    // Assemble APDU
    A := Format('00 A4 04 00 %.*x %s 00', [2, Length(AID) div 2, FormatData(AID)]);

    Send:
    // Send APDU
    P := TAPDUParser.Create('', SendAPDU(A));
    // Switch on response
    case P.Response.SW1 of

      // OK
      $90: begin
             Result := P.Response.Data;
           end;

      // Wrong Length LE
      $6C: begin
             // ReAssemble APDU and send again
             A := Format('00 A4 04 00 %.*x %s 00', [2, P.Response.SW2, FormatData(AID)]);
             GoTo Send;
           end;

      // Response Bytes still available
      $61: begin
             // Concatenate
             A := Format('00 C0 00 00 %.*x', [2, P.Response.SW2]);
             Result := Result + P.Response.Data;
             GoTo Send;
           end;

      // Not Found
      $6A: begin
             //
           end;

    end;
  finally
    P.Free;
  end;
end;

function TEMVCard.ProcessingOptions(const Application: TEMVApplication; var SW1: Byte; var SW2: Byte) : AnsiString;

  function PDOLDataBlock(const PDOL: AnsiString) : AnsiString;
  var
    A : TASNParser;
    I : Integer;
    L : Integer;
    S : AnsiString;
  begin
    S := '';
    A := TASNParser.Create;
    try
      A.Parse(PDOL);
      for I := 0 to A.Items.Count -1 do
      begin
        for L := 0 to A.Items.Items[I].Length -1 do
        S := S + '00';
      end;
    finally
      A.Free;
    end;
    Result := Format('83%.*x%s', [2, Length(S) div 2, S]);
  end;

var
  P : TAPDUParser;
  A : TASNItem;
  X : AnsiString;

  APDU : AnsiString;

label
  Send;
begin
  Result := '';
  P := TAPDUParser.Create('', '');
