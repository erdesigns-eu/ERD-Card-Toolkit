  untBIN_MAESTRO in 'untBIN_MAESTRO.pas',
  untBIN_MASTERCARD in 'untBIN_MASTERCARD.pas',
  untBIN_VISA in 'untBIN_VISA.pas',
  untLicense in 'untLicense.pas',
  SQLite3 in 'SQLite3.pas',
  SQLite3Utils in 'SQLite3Utils.pas',
  SQLite3Wrap in 'SQLite3Wrap.pas',
  untCRC16 in 'untCRC16.pas',
  untCRC32 in 'untCRC32.pas',
  untATR in 'untATR.pas',
  untATRList in 'untATRList.pas',
  untPCSC in 'untPCSC.pas',
  SCardErr in 'SCardErr.pas',
  WinSCard in 'WinSCard.pas',
