  untMemoryCardChangePIN in 'untMemoryCardChangePIN.pas' {frmMemoryCardChangePIN},
  untAbout in 'untAbout.pas' {frmAbout};

{$R *.res}

{$IFDEF RELEASE}
var
  L : string;
{$ENDIF}
begin
  Application.Initialize;
  Application.MainFormOnTaskbar := True;
  Application.Title := 'CardStudio';
  {$IFDEF RELEASE}
  // License key
  L := PKV_LicenseKeyFromRegistry;
  // Check if license key is stored, and validate License Key
  if (Length(L) = 0) or (PKV_CheckKey(L) <> KEY_VALID) then
  begin
    with TfrmEnterLicense.Create(Application) do
    if Execute = MROK then
    begin
      L := LicenseKey;
      // If License Key is valid - store Key in the registry
      // and load the mainform.
      if PKV_CheckKey(L) = KEY_VALID then
      begin
        // Store License Key
        PVK_LicenseKeyStoreRegistry(L);
        // Load mainform
        Application.CreateForm(TfrmMain, frmMain);
      end else
        // Error invalid License Key
        PVK_LicenseKeyError(Application.Handle);
    end;
  end else
  // License key found, Valid checksum - enter application.
  begin
    Application.CreateForm(TfrmMain, frmMain);
  end;
  {$ENDIF}
  {$IFDEF DEBUG}
  Application.CreateForm(TfrmMain, frmMain);
  {$ENDIF}
  Application.Run;
end.
