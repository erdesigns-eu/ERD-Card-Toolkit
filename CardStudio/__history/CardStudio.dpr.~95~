  untDecodeTracks in 'untDecodeTracks.pas' {frmTracksDecode},
  untEncodeTracks in 'untEncodeTracks.pas' {frmTracksEncode},
  untGenerateCC in 'untGenerateCC.pas' {frmGenerateCC},
  untBINCheck in 'untBINCheck.pas' {frmCheckBIN},
  untEnterLicense in 'untEnterLicense.pas' {frmEnterLicense},
  untSettings in 'untSettings.pas' {frmSettings},
