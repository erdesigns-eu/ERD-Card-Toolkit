unit untEMVTools;

interface

uses
  WinApi.Windows,
  System.SysUtils,
  System.Classes,
  System.AnsiStrings;

const
  HexChars: String = '0123456789abcdefABCDEF';

procedure StrToByteArray(Input: AnsiString; var Bytes: TBytes);
procedure StrToByteArrayAlt(Input: AnsiString; var Bytes: array of Byte);
function Hex2Bin(Input: string) : AnsiString;
function Hex2String(const Input: AnsiString) : AnsiString;
function Bin2HexExt(const Input: AnsiString; const Spaces: Boolean = True; const UpCase: Boolean = True) : string;
function Bin2Hex(const Input: AnsiString) : string;
function FormatATR(const ATR: AnsiString) : string;
function RemovePaddingF(const S: string) : string;
function NormalizePAN(const PAN: AnsiString) : AnsiString;
function DESSetOdd(s: AnsiString): AnsiString; overload;
function DESSetOdd(C: AnsiChar) : AnsiChar; overload;
function DESSetOdd(B: Byte) : Byte; overload;
function IsOdd(B: Byte) : Boolean;

implementation

{*******************************************************}
{               String to Array of Byte                 }
{*******************************************************}
procedure StrToByteArray(Input: AnsiString; var Bytes: TBytes);
begin
  // Thanks to Remy Lebeau (https://stackoverflow.com/questions/71809876/c-convertstringtobytearray-to-delphi-convertstringtobytearray/71811056#71811056)
  SetLength(Bytes, Length(Input) div 2);
  HexToBin(PAnsiChar(Input), PByte(Bytes), Length(Bytes));
end;

procedure StrToByteArrayAlt(Input: AnsiString; var Bytes: array of Byte);
var
  I, B : Integer;
begin
  for I := 0 to Length(Bytes)-1 do
  begin
    if not TryStrToInt('$' + Copy(Input, (I*2)+1, 2), B) then
      B := 0;
    Bytes[I] := Byte(B);
  end;
end;

{*******************************************************}
{                     HEX to BIN                        }
{*******************************************************}
function Hex2Bin(Input: string) : AnsiString;
var
  HEX    : AnsiString;
  Output : AnsiString;
  Loop   : Integer;
begin
  for Loop := 1 to Length(input) do
  if Pos(Input[Loop], HexChars) > 0 then
  HEX := HEX + AnsiUpperCase(AnsiChar(Input[Loop]));

  if Length(HEX) mod 2 <> 0 then HEX := '0' + HEX;

  Loop := 1;
  if Length(HEX) > 0 then
  repeat
    Output := Output + AnsiChar(StrToInt('$' + String(Copy(HEX, Loop, 2))));
    Inc(Loop, 2);
  until loop > Length(HEX);

  Result := Output;
end;

{*******************************************************}
{                    HEX to String                      }
{*******************************************************}
function Hex2String(const Input: AnsiString) : AnsiString;
begin
  SetLength(Result, Length(Input) div 2);
  HexToBin(PAnsiChar(Input), PAnsiChar(Result), Length(Result));
end;

{*******************************************************}
{                     BIN to HEX                        }
{*******************************************************}
function Bin2Hex(const Input: AnsiString) : string;
begin
  Result := Bin2HexExt(Input, False, True);
end;

{*******************************************************}
{                     BIN to HEX                        }
{*******************************************************}
function Bin2HexExt(const Input: AnsiString; const Spaces: Boolean; const UpCase: Boolean) : string;
var
  Loop : integer;
  HEX  : string;
begin
  HEX := '';

  for Loop := 1 to Length(Input) do
  begin
    HEX := HEX + IntToHex(Byte(Input[Loop]), 2);
    if Spaces then HEX := HEX + ' ';
  end;

  HEX := Trim(HEX);

  if UpCase then
    Result := AnsiUpperCase(HEX)
  else
    Result := AnsiLowerCase(HEX);
end;

{*******************************************************}
{                     Format ATR                        }
{*******************************************************}
function FormatATR(const ATR: AnsiString) : string;
var
  I : Integer;
  R : string;
begin
  R := '';
  I := 1;
  repeat
    R := R + Copy(ATR, I, 2) + ' ';
    Inc(I, 2);
  until I > Length(ATR);
  Result := Trim(R);
end;

{*******************************************************}
{                   Remove Padding                      }
{*******************************************************}
function RemovePaddingF(const S: string) : string;
begin
  Result := S;
  while (Length(Result) > 0) and (Result[Length(Result)] = 'F') do Result := Copy(Result, 1, Length(Result) - 1);
end;

{*******************************************************}
{                   Normalize PAN                       }
{*******************************************************}
function NormalizePAN(const PAN: AnsiString) : AnsiString;
var
  S: string;
begin
  S := RemovePaddingF(Bin2Hex(PAN));
  Result := Hex2Bin(S);
end;

{*******************************************************}
{                    DES Set ODD                        }
{*******************************************************}
function DESSetOdd(s: AnsiString): AnsiString;
var
  I : integer;
begin
  for I := 1 to Length(S) do
  Result := Result + DESSetOdd(S[I]);
end;

{*******************************************************}
{                    DES Set ODD                        }
{*******************************************************}
function DESSetOdd(C: AnsiChar) : AnsiChar;
begin
  Result := AnsiChar(DESSetOdd(Byte(C)));
end;

{*******************************************************}
{                    DES Set ODD                        }
{*******************************************************}
function DESSetOdd(B: Byte) : Byte;
begin
  Result := B;
  if not IsOdd(B) then Result := B xor $01;
end;

{*******************************************************}
{                    Is Byte ODD                        }
{*******************************************************}
function IsOdd(B: Byte) : Boolean;
var
  I : Integer;
begin
  Result := False;
  for I := 0 to 7 do
  if (B and (1 shl I)) <> 0 then Result := not Result;
end;

end.
