unit untHashCalculator;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Imaging.pngimage,
  Vcl.ExtCtrls;

type
  TfrmHashCalculator = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnHelp: TButton;
    btnCalculate: TButton;
    gbHash: TGroupBox;
    cbAlgorithm: TComboBox;
    gbInput: TGroupBox;
    memInput: TMemo;
    gbOutput: TGroupBox;
    memOutput: TMemo;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmHashCalculator: TfrmHashCalculator;

implementation

{$R *.dfm}

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmHashCalculator.FormCreate(Sender: TObject);
var
  I : Integer;
begin
  // Set width and height
  Width  := 550;
  Height := 400;
  // Clear memo's
  memInput.Clear;
  memOutput.Clear;
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmHashCalculator.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  Action := caFree;
  Release;
end;

end.
