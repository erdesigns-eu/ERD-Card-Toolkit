unit untLicense;

interface

uses
  Winapi.Windows, System.SysUtils;

const
  KEY_VALID       = 0;
  KEY_INVALID     = 1;
  KEY_BLACKLISTED = 2;
  KEY_PHONY       = 3;

{*******************************************************}
{                 Black Listed Seeds                    }
{*******************************************************}
const
  BL : array [0..0] of string = ('XXXXXXXX');

function PKV_GetKeyByte(const Seed : Int64; A, B, C : Byte) : Byte;
function PKV_GetChecksum(const S: string) : string;
{$IFDEF KEYGEN}
function PKV_MakeKey(const Seed : Int64) : String;
{$ENDIF}
function PKV_CheckKeyChecksum(const Key: string) : Boolean;
function PKV_CheckKey(const S: string) : Integer;
{$IFNDEF KEYGEN}
function PKV_LicenseKeyFromRegistry : string;
procedure PVK_LicenseKeyStoreRegistry(const S: string);
procedure PVK_LicenseKeyError(const H: THandle);
{$ENDIF}

implementation

uses System.StrUtils, System.Win.Registry {$IFNDEF KEYGEN},untConst{$ENDIF};

{*******************************************************}
{                     Get Key Byte                      }
{*******************************************************}
function PKV_GetKeyByte(const Seed : Int64; A, B, C : Byte) : Byte;
begin
  A := A mod 25;
  B := B mod 3;
  if A mod 2 = 0 then
    Result := ((Seed shr A) and $000000FF) xor ((Seed shr B) or C)
  else
    Result := ((Seed shr A) and $000000FF) xor ((Seed shr B) and C);
end;

{*******************************************************}
{                Get Checksum from Key                  }
{*******************************************************}
function PKV_GetChecksum(const S: string) : string;
var
  Left, Right, Sum : Word;
  I                : Integer;
begin
  Left  := $0056;
  Right := $00AF;

  if Length(S) > 0 then
  for I := 1 to Length(S) do
  begin
    Right := Right + Byte(S[I]);
    if Right > $00FF then Dec(Right, $00FF);
    Inc(Left, Right);
    if Left > $00FF then Dec(Left, $00FF);
  end;

  Sum := (Left shl 8) + Right;
  result := IntToHex(Sum, 4);
end;

{*******************************************************}
{                    Generate Key                       }
{*******************************************************}
{$IFDEF KEYGEN}
function PKV_MakeKey(const Seed : Int64) : String;
var
  KeyBytes : array[0..8] of Byte;
  I        : Integer;
begin
  KeyBytes[0] := PKV_GetKeyByte(Seed, 24, 3, 200);
  KeyBytes[1] := PKV_GetKeyByte(Seed, 10, 0, 56);
  KeyBytes[2] := PKV_GetKeyByte(Seed, 1,  2, 91);
  KeyBytes[3] := PKV_GetKeyByte(Seed, 7,  1, 100);
  KeyBytes[4] := PKV_GetKeyByte(Seed, 9,  8, 137);
  KeyBytes[5] := PKV_GetKeyByte(Seed, 16, 3, 27);
  KeyBytes[6] := PKV_GetKeyByte(Seed, 21, 5, 155);
  KeyBytes[7] := PKV_GetKeyByte(Seed, 10, 2, 61);
  KeyBytes[8] := PKV_GetKeyByte(Seed, 5,  6, 255);

  // The key string begins with a hexidecimal string of the seed
  Result := Copy(IntToHex(Seed, 8), 1, 8);

  // Then is followed by hexidecimal strings of each byte in the key
  for I := 0 to 8 do Result := Result + IntToHex(KeyBytes[I], 2);

  // Add checksum to key string
  Result := Result + PKV_GetChecksum(Result);

  // Add some hyphens to make it easier to type
  I := Length(Result) - 5;
  while (I > 1) do
  begin
    Insert('-', Result, I);
    Dec(i, 6);
  end;
end;
{$ENDIF}

{*******************************************************}
{                 Check Key Checksum                    }
{*******************************************************}
function PKV_CheckKeyChecksum(const Key: string) : Boolean;
var
  S, C: string;
begin
  Result := False;

  S := UpperCase(StringReplace(Key, '-', '', [rfReplaceAll]));
  // License keys are always 30 characters long
  if Length(S) <> 30 then Exit;

  // Last four characters are the checksum
  C := Copy(S, 27, 4);
  SetLength(S, 26);

  // Compare the supplied checksum against the real checksum for
  // the key string.
  Result := C = PKV_GetChecksum(S);
end;

{*******************************************************}
{                     Check Key                         }
{*******************************************************}
function PKV_CheckKey(const S: string) : Integer;
var
  Key, KB : string;
  Seed    : Int64;
  I       : Integer;
  B       : Byte;
begin
  Result := KEY_INVALID;
  if not PKV_CheckKeyChecksum(S) then Exit;

  // Remove cosmetic hypens and normalize case
  Key := UpperCase(StringReplace(S, '-', '', [rfReplaceAll]));

  // Test against blacklist
  if Length(BL) > 0 then
  for I := Low(BL) to High(BL) do
  if StartsStr(BL[I], Key) then Exit(KEY_BLACKLISTED);

  Result := KEY_PHONY;

  //Messagebox(0, pchar(StrToInt('$' + Copy(Key, 1, 8))), '', 0);

  // Extract the Seed from the supplied license key string
  if not TryStrToInt64('$' + Copy(Key, 1, 8), Seed) then Exit;

  {$IFDEF KEY00}
  KB := Copy(Key, 9, 2);
  B := PKV_GetKeyByte(Seed, 24, 3, 200);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  Messagebox(0, 'PASS 0', '', 0);

  {$IFDEF KEY01}
  KB := Copy(Key, 11, 2);
  B := PKV_GetKeyByte(Seed, 10, 0, 56);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  Messagebox(0, 'PASS 1', '', 0);

  {$IFDEF KEY02}
  KB := Copy(Key, 13, 2);
  B := PKV_GetKeyByte(Seed, 1, 2, 91);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  Messagebox(0, 'PASS 2', '', 0);

  {$IFDEF KEY03}
  KB := Copy(Key, 15, 2);
  B := PKV_GetKeyByte(Seed, 7, 1, 100);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  Messagebox(0, 'PASS 3', '', 0);

  {$IFDEF KEY04}
  KB := Copy(Key, 17, 2);
  B := PKV_GetKeyByte(Seed, 9, 8, 137);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  Messagebox(0, 'PASS 4', '', 0);

  {$IFDEF KEY05}
  KB := Copy(Key, 19, 2);
  B := PKV_GetKeyByte(Seed, 16, 3, 27);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  {$IFDEF KEY06}
  KB := Copy(Key, 21, 2);
  B := PKV_GetKeyByte(Seed, 21, 5, 155);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  {$IFDEF KEY07}
  KB := Copy(Key, 23, 2);
  B := PKV_GetKeyByte(Seed, 10, 2, 61);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  {$IFDEF KEY08}
  KB := Copy(Key, 25, 2);
  B := PKV_GetKeyByte(Seed, 5, 6, 255);
  if KB <> IntToHex(B, 2) then Exit;
  {$ENDIF}

  Result := KEY_VALID;
end;

{*******************************************************}
{        Read the License key from the Registry         }
{*******************************************************}
{$IFNDEF KEYGEN}
function PKV_LicenseKeyFromRegistry : string;
var
  R : TRegistry;
begin
  Result := '';
  R := TRegistry.Create;
  try
    R.RootKey := HKEY_CURRENT_USER;
    if R.OpenKey(ApplicationRegKey, True) then
    begin
      if R.ValueExists(LicenseKeyRegV) then
      Result := R.ReadString(LicenseKeyRegV);
    end;
  finally
    R.Free;
  end;
end;
{$ENDIF}

{*******************************************************}
{         Store the License Key in the Registry         }
{*******************************************************}
{$IFNDEF KEYGEN}
procedure PVK_LicenseKeyStoreRegistry(const S: string);
var
  R : TRegistry;
begin
  R := TRegistry.Create;
  try
    R.RootKey := HKEY_CURRENT_USER;
    // Create key if not already exists
    if not R.KeyExists(ApplicationRegKey) then
    R.CreateKey(ApplicationRegKey);
    // Open key and write License key
    if R.OpenKey(ApplicationRegKey, True) then
    R.WriteString(LicenseKeyRegV, S);
  finally
    R.Free;
  end;
end;
{$ENDIF}

{*******************************************************}
{         No valid License Key found message            }
{*******************************************************}
{$IFNDEF KEYGEN}
procedure PVK_LicenseKeyError(const H: THandle);
begin
  MessageBox(H, LicenseKeyError, ApplicationTitle, MB_ICONWARNING + MB_OK);
end;
{$ENDIF}

end.
