unit untGPSecurity;

interface

uses
  WinApi.Windows;

const
  OP_201 = 201;
  GP_211 = 211;

  // Secure Channel stuff

  GP211_SCP01 = $01;
  GP211_SCP02 = $02;
  GP211_SCP03 = $03;

  GP211_SCP01_IMPL_i05 = $05;
  GP211_SCP01_IMPL_i15 = $15;
  GP211_SCP02_IMPL_i44 = $44;
  GP211_SCP02_IMPL_i45 = $45;
  GP211_SCP02_IMPL_i54 = $54;
  GP211_SCP02_IMPL_i55 = $55;
  GP211_SCP02_IMPL_i04 = $04;
  GP211_SCP02_IMPL_i05 = $05;
  GP211_SCP02_IMPL_i0A = $0A;
  GP211_SCP02_IMPL_i0B = $0B;
  GP211_SCP02_IMPL_i14 = $14;
  GP211_SCP02_IMPL_i15 = $15;
  GP211_SCP02_IMPL_i1A = $1A;
  GP211_SCP02_IMPL_i1B = $1B;
  GP211_SCP03_IMPL_i00 = $00;
  GP211_SCP03_IMPL_i10 = $10;
  GP211_SCP03_IMPL_i30 = $30;
  GP211_SCP03_IMPL_i20 = $20;
  GP211_SCP03_IMPL_i60 = $60;
  GP211_SCP03_IMPL_i70 = $70;

  GP211_SCP01_SECURITY_LEVEL_C_DEC_C_MAC         = $03;
  GP211_SCP01_SECURITY_LEVEL_C_MAC               = $01;
  GP211_SCP01_SECURITY_LEVEL_NO_SECURE_MESSAGING = $00;

  GP211_SCP02_SECURITY_LEVEL_C_DEC_C_MAC_R_MAC   = $13;
  GP211_SCP02_SECURITY_LEVEL_C_MAC_R_MAC         = $11;
  GP211_SCP02_SECURITY_LEVEL_R_MAC               = $10;
  GP211_SCP02_SECURITY_LEVEL_C_DEC_C_MAC         = $03;
  GP211_SCP02_SECURITY_LEVEL_C_MAC               = $01;
  GP211_SCP02_SECURITY_LEVEL_NO_SECURE_MESSAGING = $00;

   // Philip Wendland: added SCP03 security level identifiers
  GP211_SCP03_SECURITY_LEVEL_C_DEC_C_MAC             = $03;
  GP211_SCP03_SECURITY_LEVEL_C_MAC                   = $01;
  GP211_SCP03_SECURITY_LEVEL_NO_SECURE_MESSAGING     = $00;
  GP211_SCP03_SECURITY_LEVEL_C_DEC_R_ENC_C_MAC_R_MAC = $33;
  GP211_SCP03_SECURITY_LEVEL_C_DEC_C_MAC_R_MAC       = $13;
  GP211_SCP03_SECURITY_LEVEL_C_DEC_C_MAC_R_ENC_R_MAC = $33;
  GP211_SCP03_SECURITY_LEVEL_C_MAC_R_MAC             = $11;
  GP211_SCP03_SECURITY_LEVEL_R_MAC                   = $10;
  GP211_SCP03_SECURITY_LEVEL_R_ENC_R_MAC             = $30;

  GP211_KEY_TYPE_RSA_PUB_N    = $A1;
  GP211_KEY_TYPE_RSA_PUB_E    = $A0;
  GP211_KEY_TYPE_RSA_PRIV_N   = $A2;
  GP211_KEY_TYPE_RSA_PRIV_D   = $A3;
  GP211_KEY_TYPE_RSA_PRIV_P   = $A4;
  GP211_KEY_TYPE_RSA_PRIV_Q   = $A5;
  GP211_KEY_TYPE_RSA_PRIV_PQ  = $A6;
  GP211_KEY_TYPE_RSA_PRIV_DP1 = $A7;
  GP211_KEY_TYPE_RSA_PRIV_DQ1 = $A8;

  GP211_KEY_TYPE_3DES     = $81;
  GP211_KEY_TYPE_DES      = $80;
  GP211_KEY_TYPE_3DES_CBC = $82;
  GP211_KEY_TYPE_DES_ECB  = $83;
  GP211_KEY_TYPE_DES_CBC  = $84;
  GP211_KEY_TYPE_PSK_TLS  = $85;
  GP211_KEY_TYPE_AES      = $88;

  OP201_SECURITY_LEVEL_ENC_MAC = $03;
  OP201_SECURITY_LEVEL_MAC     = $01;
  OP201_SECURITY_LEVEL_PLAIN   = $00;

  OP201_KEY_TYPE_RSA_PUP_N = $A1;
  OP201_KEY_TYPE_RSA_PUP_E = $A0;
  OP201_KEY_TYPE_DES       = $80;
  OP201_KEY_TYPE_DES_ECB   = $81;
  OP201_KEY_TYPE_DES_CBC   = $82;

type
  OP201_SECURITY_INFO = record
    securityLevel : Byte;
    sessionMacKey : array [0..16] of Byte;
    sessionEncKey : array [0..16] of Byte;
    lastMac       : array [0..8] of Byte;
    // Augusto: added two more attributes for key information
    keySetVersion : Byte;
    keyIndex      : Byte;
  end;

  GP211_SECURITY_INFO = record
    securityLevel             : Byte;
    secureChannelProtocol     : Byte;
    secureChannelProtocolImpl : Byte;
    C_MACSessionKey           : array [0..16] of Byte;
    R_MACSessionKey           : array [0..16] of Byte;
    encryptionSessionKey      : array [0..16] of Byte;
    dataEncryptionSessionKey  : array [0..16] of Byte;

    (*
     * Philip Wendland: lastC_MAC must be 16 Bytes for SCP03 because the MAC chaining value
     * for MAC code generation is 16 Bytes (according to GP 2.2 Amendment D), not 8.
     * TODO This probably affects R_MAC too.
     *)

     lastC_MAC                : array [0..16] of Byte;
     lastR_MAC                : array [0..8] of Byte;
     // Augusto: added two more attributes for key information
     keySetVersion            : Byte;
     keyIndex                 : Byte;
     invokingAid              : array [0..16] of Byte;
     invokingAidLength        : DWORD;
     sessionEncryptionCounter : LONG;
  end;
  PGP211_SECURITY_INFO = ^GP211_SECURITY_INFO;

  OP201_DAP_BLOCK = record
    securityDomainAIDLength : Byte;
    securityDomainAID       : array [0..16] of Byte;
    signatureLength         : Byte;
    signature               : array [0..128] of Byte;
  end;
  OP201_RSA_DAP_BLOCK  = OP201_DAP_BLOCK;
  OP201_3DES_DAP_BLOCK = OP201_DAP_BLOCK;

  OP201_RECEIPT_DATA = record
    receiptLength             : Byte;
    receipt                   : array [0..8] of Byte;
    confirmationCounterLength : Byte;
    confirmationCounter       : array [0..2] of Byte;
    cardUniqueDataLength      : Byte;
    cardUniqueData            : array [0..10] of Byte;
  end;

  OP201_KEY_INFORMATION = record
    keySetVersion : Byte;
    keyIndex      : Byte;
    keyType       : Byte;
    keyLength     : Byte;
  end;

  GP211_DAP_BLOCK = record
    securityDomainAIDLength : Byte;
    securityDomainAID       : array [0..16] of Byte;
    signatureLength         : Byte;
    signature               : array [0..128] of Byte;
  end;
  GP211_RSA_DAP_BLOCK  = GP211_DAP_BLOCK;
  GP211_3DES_DAP_BLOCK = GP211_DAP_BLOCK;

  GP211_RECEIPT_DATA = record
    receiptLength             : Byte;
    receipt                   : array [0..8] of Byte;
    confirmationCounterLength : Byte;
    confirmationCounter       : array [0..2] of Byte;
    cardUniqueDataLength      : Byte;
    cardUniqueData            : array [0..10] of Byte;
  end;
  PGP211_RECEIPT_DATA = ^GP211_RECEIPT_DATA;

  GP211_KEY_INFORMATION = record
    keySetVersion : Byte;
    keyIndex      : Byte;
    keyType       : Byte;
    keyLength     : USHORT;
    keyUsage      : Byte;
    keyAccess     : Byte;
  end;
  PGP211_KEY_INFORMATION = ^GP211_KEY_INFORMATION;

implementation

end.
