{     APDU (Application Protocol Data Unit) Parser      }
{                                                       }
{*******************************************************}

unit untAPDUParser;

interface

uses
  WinApi.Windows,
  System.SysUtils,
  System.Classes,
  untEMVTools;

type
  {*******************************************************}
  {            APDU Command Instruction Record            }
  {*******************************************************}
  TADPUCommandInstruction = record
    INS         : Byte;
    Standard    : string;
    Description : string;
  end;

  {*******************************************************}
  {               APDU Response Status Type               }
  {*******************************************************}
  TADPUResponseStatusType = (
    rstInfo,
    rstWarning,
    rstError,
    rstSecurity,
    rstUnknown
  );

  {*******************************************************}
  {              APDU Response Status Record              }
  {*******************************************************}
  TADPUResponseStatus = record
    SW1         : Byte;
    SW2         : Byte;
    StatusType  : TADPUResponseStatusType;
    Description : string;
  end;

  {*******************************************************}
  {                  APDU Command Class                   }
  {*******************************************************}
  TAPDUCommand = record
    CLA  : Byte;   // Class
    INS  : Byte;   // Intruction
    P1   : Byte;   // Parameter 1
    P2   : Byte;   // Parameter 2
    LC   : Byte;   // Length Command
    Data : string; // Data
    LE   : Byte;   // Length Expected (Response)
  end;

  {*******************************************************}
  {                  APDU Response Class                  }
  {*******************************************************}
  TAPDUResponse = record
    Data : string; // Data
    SW1  : Byte;   // Status 1
    SW2  : Byte;   // Status 2
  end;

  {*******************************************************}
  {                   APDU Parser Class                   }
  {*******************************************************}
  TAPDUParser = class
  private
    FADPUCommandS  : AnsiString;
    FAPDUCommand   : TAPDUCommand;
    FADPUResponseS : AnsiString;
    FAPDUResponse  : TAPDUResponse;

    function GetByteAtIndex(const B: TBytes; const I: Integer) : Byte;
    function GetCommandInstruction : TADPUCommandInstruction;
    function GetResponseStatus : TADPUResponseStatus;
  public
    constructor Create(const Command: AnsiString = ''; const Response: AnsiString = ''); virtual;
    destructor Destroy; override;

    procedure ParseCommand; overload;
    procedure ParseCommand(const Command: AnsiString); overload;
    procedure ParseResponse; overload;
    procedure ParseResponse(const Response: AnsiString); overload;

    property Command: TAPDUCommand read FAPDUCommand;
    property CommandText: AnsiString read FADPUCommandS write FADPUCommandS;
    property CommandInstruction: TADPUCommandInstruction read GetCommandInstruction;
    property Response: TAPDUResponse read FAPDUResponse;
    property ResponseText: AnsiString read FADPUResponseS write FADPUResponseS;
    property ResponseStatus: TADPUResponseStatus read GetResponseStatus;
  end;

