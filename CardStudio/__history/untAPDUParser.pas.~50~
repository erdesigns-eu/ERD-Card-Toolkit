{*******************************************************}
{               APDU Parser Constructor                 }
{*******************************************************}
constructor TAPDUParser.Create(const Command: AnsiString = ''; const Response: AnsiString = '');
begin
  inherited Create;

  // Command
  if Length(Command) > 0 then
  begin
    FADPUCommandS := Command;
    ParseCommand(Command);
  end;

  // Response
  if Length(Response) > 0 then
  begin
    FADPUResponseS := Response;
    ParseResponse(Response);
  end;

end;

{*******************************************************}
{               APDU Parser Desstructor                 }
{*******************************************************}
destructor TAPDUParser.Destroy;
begin
  inherited Destroy;
end;

{*******************************************************}
{               Try and get Byte at Index               }
{*******************************************************}
function TAPDUParser.GetByteAtIndex(const B: TBytes; const I: Integer) : Byte;
begin
  if I < Length(B) then
    Result := B[I]
  else
    Result := $00;
end;

{*******************************************************}
{             Try find Command Instruction              }
{*******************************************************}
function TAPDUParser.GetCommandInstruction : TADPUCommandInstruction;
var
  I : Integer;
begin
  // Default
  Result := UnknownCommandInstruction;
  // Find Command instruction
  for I := Low(APDUCommandInstructions) to High(APDUCommandInstructions) do
  if APDUCommandInstructions[I].INS = FAPDUCommand.INS then
  begin
    Result := APDUCommandInstructions[I];
    Break;
  end;
end;

{*******************************************************}
{               Try find Response Status                }
{*******************************************************}
function TAPDUParser.GetResponseStatus : TADPUResponseStatus;
var
  I : Integer;
begin
  // Default
  Result := UnknownResponseStatus;
  // Find Command instruction
  for I := Low(APDUResponseStatuses) to High(APDUResponseStatuses) do
  if (APDUResponseStatuses[I].SW1 = FAPDUResponse.SW1) and
     (APDUResponseStatuses[I].SW2 = FAPDUResponse.SW2) then
  begin
    Result := APDUResponseStatuses[I];
    Break;
  end;
end;

{*******************************************************}
{                     Parse Command                     }
{*******************************************************}
procedure TAPDUParser.ParseCommand;
begin
  ParseCommand(FADPUCommandS);
end;

{*******************************************************}
{                     Parse Command                     }
{*******************************************************}
procedure TAPDUParser.ParseCommand(const Command: AnsiString);
var
  B : TBytes;
begin
  StrToByteArray(Command, B);
  with FAPDUCommand do
  begin
    // Class
    CLA := GetByteAtIndex(B, 0);
    // Instruction
    INS := GetByteAtIndex(B, 1);
    // Parameter 1
    P1  := GetByteAtIndex(B, 2);
    // Parameter 2
    P2  := GetByteAtIndex(B, 3);
    // Length Command
    LC  := GetByteAtIndex(B, 4);
    // Data
    if Length(Command) > 11 then
    Data := Copy(Command, 11, Length(Command) - 10);
    // Length Expected
    LE  := GetByteAtIndex(B, 4 + LC);
  end;
end;

{*******************************************************}
{                     Parse Response                    }
{*******************************************************}
procedure TAPDUParser.ParseResponse;
begin
  ParseResponse(FADPUResponseS);
end;

{*******************************************************}
{                     Parse Response                    }
{*******************************************************}
procedure TAPDUParser.ParseResponse(const Response: AnsiString);
var
  B : TBytes;
  I : Integer;
begin
  StrToByteArray(Response, B);
  with FAPDUResponse do
  begin
    I := Length(Response);
    if (I > 4) then
    begin
      // Data
      Data := Copy(Response, 1, I - 4);
      // Status 1
      SW1 := GetByteAtIndex(B, Length(B) - 2);
      // Status 2
      SW2 := GetByteAtIndex(B, Length(B) - 1);
    end else
    begin
      // Data
      Data := '';
      // Status 1
      SW1 := GetByteAtIndex(B, Length(B) - 2);
      // Status 2
      SW2 := GetByteAtIndex(B, Length(B) - 1);
    end;
  end;
end;

