unit untBINCheck;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Imaging.pngimage,
  Vcl.ExtCtrls, IdIOHandler, IdIOHandlerSocket, IdIOHandlerStack, IdSSL,
  IdSSLOpenSSL, IdBaseComponent, IdComponent, IdTCPConnection, IdTCPClient,
  IdHTTP, IdZLibCompressorBase, IdCompressorZLib, IdAntiFreezeBase, IdAntiFreeze,
  Vcl.Menus;

type
  TfrmCheckBIN = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Panel2: TPanel;
    btnHelp: TButton;
    btnCheck: TButton;
    gbPAN: TGroupBox;
    edtCardNumber: TEdit;
    gbBINData: TGroupBox;
    memBINData: TMemo;
    HTTP: TIdHTTP;
    IdSSLIOHandlerSocketOpenSSL1: TIdSSLIOHandlerSocketOpenSSL;
    btnSettings: TButton;
    IdCompressorZLib: TIdCompressorZLib;
    SaveDialog: TSaveDialog;
    PopupMenu: TPopupMenu;
    SelectAll1: TMenuItem;
    N2: TMenuItem;
    Copy1: TMenuItem;
    N1: TMenuItem;
    Savetofile1: TMenuItem;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnCheckClick(Sender: TObject);
    procedure btnSettingsClick(Sender: TObject);
    procedure Savetofile1Click(Sender: TObject);
  private
    { Private declarations }
    FBinCheck       : Integer;
    FBinCodesAPIKey : string;
    FBinTableAPIKey : string;
    FAPILayerAPIKey : string;
  public
    { Public declarations }
    procedure LoadSettings;
    procedure Execute(const PAN: string = '');
  end;

var
  frmCheckBIN: TfrmCheckBIN;

implementation

{$R *.dfm}

uses untConst, Registry, untBIN, untBIN_AMEX, untBIN_DINERSCLUB, untBIN_DISCOVER,
     untBIN_JCB, untBIN_MAESTRO, untBIN_MASTERCARD, untBIN_VISA, untSettings, JSON;

{*******************************************************}
{             Load Settings from Registry               }
{*******************************************************}
procedure TfrmCheckBIN.LoadSettings;
var
  R : TRegistry;
begin
  R := TRegistry.Create;
  try
    R.RootKey := HKEY_CURRENT_USER;
    if R.OpenKey(ApplicationRegKey, True) then
    begin
      // BinCodes.com
      if R.ValueExists(BINCheckBinCodesAPIKEY) then
      FBinCodesAPIKey := R.ReadString(BINCheckBinCodesAPIKEY);
      // BinTable.com
      if R.ValueExists(BINCheckBinTableAPIKEY) then
      FBinTableAPIKey := R.ReadString(BINCheckBinTableAPIKEY);
      // APILayer
      if R.ValueExists(BINCheckAPILayerAPIKEY) then
      FAPILayerAPIKey := R.ReadString(BINCheckAPILayerAPIKEY);
      // Default BIN check
      if R.ValueExists(BINCheckDefault) then
        FBinCheck := R.ReadInteger(BINCheckDefault)
      else
        FBinCheck := 0;
    end;
  finally
    R.Free;
  end;
end;

{*******************************************************}
{                  Execute Dialog                       }
{*******************************************************}
procedure TfrmCheckBIN.Execute(const PAN: string = '');
begin
  LoadSettings;
  edtCardNumber.Text := PAN;
  Show;
  Application.ProcessMessages;
  if Length(edtCardNumber.Text) > 0 then
  btnCheck.Click;
end;

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmCheckBIN.FormCreate(Sender: TObject);
begin
  // Set width and height
  Width  := 640;
  Height := 480;
  // Clear PAN
  edtCardNumber.Clear;
  // Clear memo's
  memBINData.Clear;
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmCheckBIN.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  Action := caFree;
  Release;
  frmCheckBIN := nil;
end;

{*******************************************************}
{                     Check BIN                         }
{*******************************************************}
procedure TfrmCheckBIN.btnCheckClick(Sender: TObject);

  function HTTP_GET(const URL: string) : string;
  begin
    try
      Result := HTTP.Get(URL);
      Application.ProcessMessages;
    except
      Result := '';
    end;
  end;

  function HTTP_POST(const URL: string) : string;
  var
    P : TStringList;
  begin
    P := TStringList.Create;
    try
      try
        Result := HTTP.post(URL, P);
        Application.ProcessMessages;
      except
        Result := '';
      end;
    finally
      P.Free;
    end;
  end;

  procedure FormatBINCheck(PAN: string; Scheme: string;
    CardType: string; Category: string; Issuer: string;
    URL: string; Country: string; Currency: string);
  var
    C : TCardScheme;
  begin
    // Find card scheme
    C := FindCardScheme(Copy(edtCardNumber.Text, 1, 6));
    with memBINData.Lines do
    begin
      // Clear Memo
      Clear;
      // Header
      Add(BINCheckHeader);
      // PAN
      Add(Format(BINCheckPAN, [FormatPAN(PAN, C)]));
      // Scheme
      Add(Format(BINCheckScheme, [Scheme]));
      // Card Type
      Add(Format(BINCheckType, [CardType]));
      // Category
      Add(Format(BINCheckCategory, [Category]));
      // Issuer / Bank
      Add(Format(BINCheckIssuer, [Issuer]));
      // Issuer URL
      Add(Format(BINCheckURL, [URL]));
      // Country
      Add(Format(BINCheckCountry, [Country]));
      // Currency
      Add(Format(BINCheckCurrency, [Currency]));
    end;
  end;

  procedure CardStudioCheck(const B: string);
  var
    C : TCardScheme;
    I : Integer;
  begin
    // Find card scheme
    C := FindCardScheme(B);
    case C of
      csAMEX:
      begin
        I := FindBIN(BINS_AMEX, B);
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          CardTypeToStr(BINS_AMEX[I].iin_type),
          BINS_AMEX[I].iin_category,
          BINS_AMEX[I].iin_issuer,
          BINS_AMEX[I].iin_issuer_url,
          CountryCodeToStr(BINS_AMEX[I].iin_country),
          CurrencyCodeToStr(BINS_AMEX[I].iin_currency)
        );
      end;

      csDISCOVER:
      begin
        I := FindBIN(BINS_DISCOVER, B);
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          CardTypeToStr(BINS_DISCOVER[I].iin_type),
          BINS_DISCOVER[I].iin_category,
          BINS_DISCOVER[I].iin_issuer,
          BINS_DISCOVER[I].iin_issuer_url,
          CountryCodeToStr(BINS_DISCOVER[I].iin_country),
          CurrencyCodeToStr(BINS_DISCOVER[I].iin_currency)
        );
      end;

      csDINERSCLUBINTERNATIONAL:
      begin
        I := FindBIN(BINS_DINERSCLUB, B);
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          CardTypeToStr(BINS_DINERSCLUB[I].iin_type),
          BINS_DINERSCLUB[I].iin_category,
          BINS_DINERSCLUB[I].iin_issuer,
          BINS_DINERSCLUB[I].iin_issuer_url,
          CountryCodeToStr(BINS_DINERSCLUB[I].iin_country),
          CurrencyCodeToStr(BINS_DINERSCLUB[I].iin_currency)
        );
      end;

      csJCB:
      begin
        I := FindBIN(BINS_JCB, B);
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          CardTypeToStr(BINS_JCB[I].iin_type),
          BINS_JCB[I].iin_category,
          BINS_JCB[I].iin_issuer,
          BINS_JCB[I].iin_issuer_url,
          CountryCodeToStr(BINS_JCB[I].iin_country),
          CurrencyCodeToStr(BINS_JCB[I].iin_currency)
        );
      end;

      csMASTERCARD:
      begin
        I := FindBIN(BINS_MASTERCARD, B);
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          CardTypeToStr(BINS_MASTERCARD[I].iin_type),
          BINS_MASTERCARD[I].iin_category,
          BINS_MASTERCARD[I].iin_issuer,
          BINS_MASTERCARD[I].iin_issuer_url,
          CountryCodeToStr(BINS_MASTERCARD[I].iin_country),
          CurrencyCodeToStr(BINS_MASTERCARD[I].iin_currency)
        );
      end;

      csMAESTRO:
      begin
        I := FindBIN(BINS_MAESTRO, B);
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          CardTypeToStr(BINS_MAESTRO[I].iin_type),
          BINS_MAESTRO[I].iin_category,
          BINS_MAESTRO[I].iin_issuer,
          BINS_MAESTRO[I].iin_issuer_url,
          CountryCodeToStr(BINS_MAESTRO[I].iin_country),
          CurrencyCodeToStr(BINS_MAESTRO[I].iin_currency)
        );
      end;

      csVISA:
      begin
        I := FindBIN(BINS_VISA, B);
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          CardTypeToStr(BINS_VISA[I].iin_type),
          BINS_VISA[I].iin_category,
          BINS_VISA[I].iin_issuer,
          BINS_VISA[I].iin_issuer_url,
          CountryCodeToStr(BINS_VISA[I].iin_country),
          CurrencyCodeToStr(BINS_VISA[I].iin_currency)
        );
      end;
    end;
  end;

  procedure BinListNetCheck(const B: string);
  var
    C : TCardScheme;
    R : string;
    J : TJSonValue;
  begin
    // Find card scheme
    C := FindCardScheme(B);
    // Lookup
    HTTP.Request.CustomHeaders.Clear;
    R := HTTP_GET(Format('https://lookup.binlist.net/%s', [Copy(B, 1, 6)]));
    if (R.Length > 0) then
    begin
      J := TJSonObject.ParseJSONValue(R);
      try
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          Uppercase(J.GetValue<string>('type', 'N/A')),
          'N/A',
          J.GetValue<string>('bank.name', 'N/A'),
          J.GetValue<string>('bank.url', 'N/A'),
          J.GetValue<string>('country.name', 'N/A'),
          J.GetValue<string>('country.currency', 'N/A')
        );
      finally
        J.Free;
      end;
    end;
  end;

  procedure BinCodesComCheck(const B: string);
  var
    C : TCardScheme;
    R : string;
    J : TJSonValue;
  begin
    // Find card scheme
    C := FindCardScheme(B);
    // Lookup
    HTTP.Request.CustomHeaders.Clear;
    R := HTTP_GET(Format('https://api.bincodes.com/bin/json/%s/%s/', [FBinCodesAPIKey, Copy(B, 1, 6)]));
    if (R.Length > 0) then
    begin
      J := TJSonObject.ParseJSONValue(R);
      try

        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          Uppercase(J.GetValue<string>('type', 'N/A')),
          J.GetValue<string>('level', 'N/A'),
          J.GetValue<string>('bank', 'N/A'),
          J.GetValue<string>('website', 'N/A'),
          J.GetValue<string>('country', 'N/A'),
          'N/A'
        );
      finally
        J.Free;
      end;
    end;
  end;

  procedure BinTableCheck(const B: string);
  var
    C : TCardScheme;
    R : string;
    J : TJSonValue;
  begin
    // Find card scheme
    C := FindCardScheme(B);
    // Lookup
    HTTP.Request.CustomHeaders.Clear;
    R := HTTP_GET(Format('https://api.bintable.com/v1/%s?api_key=%s', [Copy(B, 1, 6), FBinTableAPIKey]));
    if (R.Length > 0) then
    begin
      J := TJSonObject.ParseJSONValue(R);
      try
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          Uppercase(J.GetValue<string>('data.card.type', 'N/A')),
          J.GetValue<string>('data.card.category', 'N/A'),
          J.GetValue<string>('data.bank.name', 'N/A'),
          J.GetValue<string>('data.bank.website', 'N/A'),
          J.GetValue<string>('data.country.name', 'N/A'),
          J.GetValue<string>('data.country.currency_code', 'N/A')
        );
      finally
        J.Free;
      end;
    end;
  end;

  procedure APILayerCheck(const B: string);
  var
    C : TCardScheme;
    R : string;
    J : TJSonValue;
  begin
    // Find card scheme
    C := FindCardScheme(B);
    // Lookup
    HTTP.Request.CustomHeaders.Add(Format('apikey: %s', [FAPILayerAPIKey]));
    R := HTTP_GET(Format('https://api.apilayer.com/bincheck/%s', [Copy(B, 1, 6)]));
    if (R.Length > 0) then
    begin
      J := TJSonObject.ParseJSONValue(R);
      try
        FormatBINCheck(
          FormatPAN(B, C),
          CardSchemeToStr(C),
          Uppercase(J.GetValue<string>('type', 'N/A')),
          'N/A',
          J.GetValue<string>('bank_name', 'N/A'),
          J.GetValue<string>('url', 'N/A'),
          J.GetValue<string>('country', 'N/A'),
          'N/A'
        );
      finally
        J.Free;
      end;
    end;
  end;

begin
  case FBinCheck of
    0 : CardStudioCheck(edtCardNumber.Text);
    1 : BinListNetCheck(edtCardNumber.Text);
    2 : BinCodesComCheck(edtCardNumber.Text);
    3 : BinTableCheck(edtCardNumber.Text);
    4 : APILayerCheck(edtCardNumber.Text);
  end;
end;

{*******************************************************}
{                Show Settings Dialog                   }
{*******************************************************}
procedure TfrmCheckBIN.btnSettingsClick(Sender: TObject);
begin
  with TfrmSettings.Create(Application) do
  if Execute(8) = MROK then SaveSettings;
  LoadSettings;
end;

{*******************************************************}
{                     Save to file                      }
{*******************************************************}
procedure TfrmCheckBIN.Savetofile1Click(Sender: TObject);
begin
  if SaveDialog.Execute(Handle) and (Length(SaveDialog.FileName) > 0) then
  begin
    memBINData.Lines.SaveToFile(SaveDialog.FileName);
  end;
end;

end.
