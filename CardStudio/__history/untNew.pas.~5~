unit untNew;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls,
  System.ImageList, Vcl.ImgList, Vcl.Imaging.pngimage, Vcl.ComCtrls;

type
  TfrmNew = class(TForm)
    Panel2: TPanel;
    btnHelp: TButton;
    btnBack: TButton;
    btnNext: TButton;
    Panel1: TPanel;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    PC: TPageControl;
    tsInfo: TTabSheet;
    gbAuthor: TGroupBox;
    edtAuthor: TEdit;
    gbWebsite: TGroupBox;
    edtWebsite: TEdit;
    gbEmail: TGroupBox;
    edtEmail: TEdit;
    gbTelegram: TGroupBox;
    edtTelegram: TEdit;
    gbComment: TGroupBox;
    memComment: TMemo;
    tsCard: TTabSheet;
    gbCardType: TGroupBox;
    cbCardType: TComboBox;
    gbCardScheme: TGroupBox;
    cbCardScheme: TComboBox;
    gbApplet: TGroupBox;
    cbApplet: TComboBox;
    gbATR: TGroupBox;
    edtATR: TEdit;
    gbPINCode: TGroupBox;
    edtPINCode: TEdit;
    tsMagStripe: TTabSheet;
    tsEMV: TTabSheet;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmNew: TfrmNew;

implementation

{$R *.dfm}

{*******************************************************}
{                  Form Create Event                    }
{*******************************************************}
procedure TfrmNew.FormCreate(Sender: TObject);
var
  I : Integer;
begin
  // Set width and height
  Width  := 640;
  Height := 480;
  // Reset controls
  for I := 0 to ComponentCount -1 do
  begin
    // Page Controls
    if Components[I].ClassNameIs('TPageControl') and ((Components[I] as TPageControl).Tag = 0) then
    (Components[I] as TPageControl).ActivePageIndex := 0;
    // Tab Sheets
    if Components[I].ClassNameIs('TTabSheet') and ((Components[I] as TTabSheet).Tag = 0) then
    (Components[I] as TTabSheet).TabVisible := False;
    // Memo's
    if Components[I].ClassNameIs('TMemo') and ((Components[I] as TMemo).Tag = 0) then
    (Components[I] as TMemo).Clear;
    // Edit's
    if Components[I].ClassNameIs('TEdit') and ((Components[I] as TEdit).Tag = 0) then
    (Components[I] as TEdit).Clear;
  end;
end;

{*******************************************************}
{                   Form Close Event                    }
{*******************************************************}
procedure TfrmNew.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  Action := caFree;
  Release;
end;

end.
