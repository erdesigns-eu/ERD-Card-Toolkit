unit untMSR_API;

interface

uses
  Winapi.Windows, System.SysUtils, System.Classes;

const
  MSR_API = 'MSR_API.dll';

// Get DLL version
function MSR_GetDLL_Ver(rVer: PAnsiChar) : integer; stdcall; external MSR_API;
// Connect
function MSR_InitComm(portname: PAnsiChar; baud: LongWord) : Bool; stdcall; external MSR_API;
// Disconnect
function MSR_ExitComm : integer; stdcall; external MSR_API;

// Control Buzzer
function MSR_CtrlBUZZ(sound: PAnsiChar; len: Byte) : integer; stdcall; external MSR_API;

// Reset
function MSR_Reset : integer; stdcall; external MSR_API;
// Read
function MSR_Read : integer; stdcall; external MSR_API;
// Write
function MSR_Write(TK1Dat: PAnsiChar; TK2Dat: PAnsiCHar; TK3Dat: PAnsiChar) : integer; stdcall; external MSR_API;
// Comm Test
function MSR_CommTest : integer; stdcall; external MSR_API;
// All Leds Off
function MSR_All_LED_Off : integer; stdcall; external MSR_API;
// All Leds On
function MSR_All_LED_On : integer; stdcall; external MSR_API;
// Green Led On
function MSR_Green_LED_On : integer; stdcall; external MSR_API;
// Yellow Led On
function MSR_Yellow_LED_On : integer; stdcall; external MSR_API;
// Red Led On
function MSR_Red_LED_On : integer; stdcall; external MSR_API;
// Sensor Test
function MSR_Sensor_Test : integer; stdcall; external MSR_API;
// Ram Test
function MSR_Ram_Test : integer; stdcall; external MSR_API;
// Set Leading Zero
function MSR_Set_Leading_Zero(Lead210: integer; Lead75: integer) : integer; stdcall; external MSR_API;
// Check Leading Zero
function MSR_Check_Leading_Zero(Lead210: PInteger; Lead75: PInteger) : integer; stdcall; external MSR_API;
// Erase Track
function MSR_Erase(SelectTrack: integer) : integer; stdcall; external MSR_API;
// Select BPI
function MSR_Select_BPI(TK2Density: Byte) : integer; stdcall; external MSR_API;
// Raw Read
function MSR_Raw_Read : integer; stdcall; external MSR_API;
// Raw Write
function MSR_Raw_Write(TK1Dat: PAnsiChar; TK2Dat: PAnsiChar; TK3Dat: PAnsiChar) : integer; stdcall; external MSR_API;
// Get Device Model
function MSR_Get_Device_Model(model: PAnsiChar) : integer; stdcall; external MSR_API;
// Get Firmware Version
function MSR_Get_Firmware_Version(version: PAnsiChar) : integer; stdcall; external MSR_API;
// Set BPC
function MSR_Set_BPC(TK1Bit: integer; TK2Bit: integer; TK3Bit: integer) : integer; stdcall; external MSR_API;
// Set HiCo
function MSR_Set_HiCo : integer; stdcall; external MSR_API;
// Set LoCo
function MSR_Set_LoCo : integer; stdcall; external MSR_API;
// Get Co Status
function MSR_Get_CoStatus(status: PAnsiChar) : integer; stdcall; external MSR_API;
// Get Write Erase Status
function MSR_Get_Write_Erase_Status : integer; stdcall; external MSR_API;
// Get Read Data
function MSR_Get_Read_Data(TK1Dat: PByte; TK2Dat: PByte; TK3Dat: PByte) : integer; stdcall; external MSR_API;
// Get Raw Read Data
function MSR_Get_RawRead_Data(TK1Dat: PAnsiChar; TK2Dat: PAnsiChar; TK3Dat: PAnsiChar) : integer; stdcall; external MSR_API;


implementation

end.
