package ERDCardSIM;

{$R *.res}
{$IMPLICITBUILD ON}
{$DESCRIPTION 'ERD Card SIM: classic GSM and UICC/USIM files, contacts and verified record writes'}
{$RUNONLY}

requires
  rtl,
  ERDCardCore;

contains
  ERD.Card.SIM.Workflow in '..\..\src\sim\ERD.Card.SIM.Workflow.pas',
  ERD.Card.SIM.Inspection in '..\..\src\sim\ERD.Card.SIM.Inspection.pas',
  ERD.Card.SIM.Data in '..\..\src\sim\ERD.Card.SIM.Data.pas',
  ERD.Card.SIM.Reader in '..\..\src\sim\ERD.Card.SIM.Reader.pas';

end.
