package ERDCardEMV;

{$R *.res}
{$IMPLICITBUILD ON}

{$DESCRIPTION 'ERD Card EMV: application discovery, data codecs and non-visual reader'}
{$RUNONLY}

requires
  rtl,
  ERDCardCore;

contains
  ERD.Card.EMV.Inspection in '..\..\src\emv\ERD.Card.EMV.Inspection.pas',
  ERD.Card.EMV.Semantics in '..\..\src\emv\ERD.Card.EMV.Semantics.pas',
  ERD.Card.EMV.Aids in '..\..\src\emv\ERD.Card.EMV.Aids.pas',
  ERD.Card.EMV.LegacyTags in '..\..\src\emv\ERD.Card.EMV.LegacyTags.pas',
  ERD.Card.EMV.Calculator in '..\..\src\emv\ERD.Card.EMV.Calculator.pas',
  ERD.Card.EMV.Tags in '..\..\src\emv\ERD.Card.EMV.Tags.pas',
  ERD.Card.EMV.Data in '..\..\src\emv\ERD.Card.EMV.Data.pas',
  ERD.Card.EMV.Reader in '..\..\src\emv\ERD.Card.EMV.Reader.pas';

end.
