    <ProjectVersion>19.0</ProjectVersion>
    <MainSource>ERDCardContactless.dpk</MainSource>
    <AppType>Package</AppType>
    <FrameworkType>None</FrameworkType>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_UnitSearchPath>..\..\src\core;..\..\src\crypto;..\..\src\pcsc;..\..\src\eid;..\..\src\emv;..\..\src\magstripe;..\..\src\contactless;..\..\dist\packages\$(Platform)\$(Config);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
