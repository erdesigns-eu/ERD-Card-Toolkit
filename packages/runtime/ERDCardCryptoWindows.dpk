package ERDCardCryptoWindows;

{$R *.res}
{$IMPLICITBUILD ON}

{$DESCRIPTION 'ERD Card Windows cryptography: CNG AES-128 and system CSPRNG'}
{$RUNONLY}

requires
  rtl,
  ERDCardCore;

contains
  ERD.Card.Crypto.RSA.Native in '..\..\src\crypto\ERD.Card.Crypto.RSA.Native.pas',
  ERD.Card.Crypto.Hash.Windows in '..\..\src\crypto\ERD.Card.Crypto.Hash.Windows.pas',
  ERD.Card.Crypto.Windows in '..\..\src\crypto\ERD.Card.Crypto.Windows.pas';

end.
