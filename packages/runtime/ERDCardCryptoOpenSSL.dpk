package ERDCardCryptoOpenSSL;

{$R *.res}
{$IMPLICITBUILD ON}

{$DESCRIPTION 'ERD Card optional OpenSSL 3 ICAO BAC/PACE and AES provider'}
{$RUNONLY}

requires
  rtl,
  ERDCardCore;

contains
  ERD.Card.Crypto.Hash.OpenSSL in '..\..\src\crypto\ERD.Card.Crypto.Hash.OpenSSL.pas',
  ERD.Card.Crypto.EAC.OpenSSL in '..\..\src\crypto\ERD.Card.Crypto.EAC.OpenSSL.pas';

end.
