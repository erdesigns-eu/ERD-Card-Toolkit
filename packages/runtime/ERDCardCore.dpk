package ERDCardCore;

{$R *.res}
{$IMPLICITBUILD ON}

{$DESCRIPTION 'ERD Card core: bytes, APDU, ATR and BER-TLV codecs'}
{$RUNONLY}

requires
  rtl;

contains
  ERD.Card.APDU.Catalog in '..\..\src\core\ERD.Card.APDU.Catalog.pas',
  ERD.Card.ATR.Legacy in '..\..\src\core\ERD.Card.ATR.Legacy.pas',
  ERD.Card.Crypto.Hash in '..\..\src\core\ERD.Card.Crypto.Hash.pas',
  ERD.Card.Crypto.DES in '..\..\src\core\ERD.Card.Crypto.DES.pas',
  ERD.Card.Events in '..\..\src\core\ERD.Card.Events.pas',
  ERD.Card.Crypto.EAC in '..\..\src\core\ERD.Card.Crypto.EAC.pas',
  ERD.Card.Crypto in '..\..\src\core\ERD.Card.Crypto.pas',
  ERD.Card.ATR.Catalog in '..\..\src\core\ERD.Card.ATR.Catalog.pas',
  ERD.Card.Bytes in '..\..\src\core\ERD.Card.Bytes.pas',
  ERD.Card.APDU in '..\..\src\core\ERD.Card.APDU.pas',
  ERD.Card.ATR in '..\..\src\core\ERD.Card.ATR.pas',
  ERD.Card.TLV in '..\..\src\core\ERD.Card.TLV.pas',
  ERD.Card.Transport in '..\..\src\core\ERD.Card.Transport.pas';

end.
